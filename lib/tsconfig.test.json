{
	"extends": ["./tsconfig.json", "../tsconfig.test-base.json"],
	"include": ["./**/*.test.ts", "./**/*.test.tsx", "./test/**/*"],
	"exclude": ["./out/**/*"],
	"compilerOptions": {
		"types": ["node"]
	},
	// Without a reference to the build project, the test program follows `@mailwoman/spatial` into its source,
	// and from there into `@mailwoman/recognize` and `@mailwoman/registry` sources, which fail under this project's options.
	"references": [{ "path": "./tsconfig.json" }]
}
