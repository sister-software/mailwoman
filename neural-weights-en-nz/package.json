{
	"name": "@mailwoman/neural-weights-en-nz",
	"version": "8.7.0",
	"description": "Mailwoman neural-classifier weights for locale 'en-nz'. Data-only overlay — shares the base model.onnx + tokenizer.model from @mailwoman/neural-weights-en-us (they are byte-identical); ships only the nz-specific data siblings. Loaded by @mailwoman/neural at runtime.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "neural-weights-en-nz"
	},
	"files": [
		"model-card.json",
		"pair-index-nz.bin",
		"fst-street-morphology.bin",
		"anchor-lexicon-v1.json",
		"locality-surface-lexicon-v6.json",
		"street-type-lexicon-v3.json",
		"country-surface-lexicon-v1.json",
		"README.md",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!scripts/**"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/neural-weights-en-us": "workspace:*"
	},
	"mailwoman": {
		"baseWeights": "@mailwoman/neural-weights-en-us"
	},
	"devDependencies": {
		"@mailwoman/core": "workspace:*"
	}
}
