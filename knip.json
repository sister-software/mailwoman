{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["corpus-python/scripts/**/*.ts", "docker/server.ts", "*.config.ts", "oxlint.plugin.ts"],
	"ignore": [
		"corpus-python/scripts/**/*.ts",
		"docker/server.ts",
		"docs/**/*.mdx",
		"docs/.agents/**",
		"docs/build/**",
		"packages/mailwoman/lib/commands/**/*.tsx",
		"packages/sentencepiece-wasm/sentencepiece.mjs",
		"packages/*/out/**"
	],
	"ignoreBinaries": ["ogr2ogr", "rg", "script", "uv", "uvx"],
	"ignoreDependencies": ["@duckdb/node-api", "ts-morph", "onnxruntime-web"],
	"workspaces": {
		"packages/*": {
			"entry": [
				"lib/index.ts",
				"lib/cli.ts",
				"lib/cli.tsx",
				"lib/scripts/**/*.ts",
				"lib/tools/**/*.ts",
				"lib/dev-tools/**/*.ts"
			]
		},
		"packages/mailwoman": {
			"entry": [
				"lib/index.ts",
				"lib/cli.tsx",
				"lib/commands/**/*.tsx",
				"lib/dev-tools/**/*.ts",
				"lib/geocode/worker.ts",
				"lib/test-fixtures/**/*"
			],
			"ignoreDependencies": ["@mailwoman/neural-weights-en-us"]
		},
		"packages/api-kit": {
			"entry": ["lib/index.ts", "test/fixtures/**/*.ts"]
		},
		"packages/dev-mcp": {
			"entry": ["lib/index.ts", "lib/cli.ts", "lib/worker.ts", "lib/hooks/*.ts"]
		},
		"packages/{fastify,libpostal,mcp,nominatim,photon}": {
			"entry": [
				"lib/index.ts",
				"lib/cli.ts",
				"lib/cli.tsx",
				"lib/scripts/**/*.ts",
				"lib/tools/**/*.ts",
				"lib/dev-tools/**/*.ts"
			],
			"ignoreDependencies": ["@mailwoman/neural", "@mailwoman/neural-weights-en-us"]
		},
		"packages/neural-weights-*": {
			"entry": ["index.ts", "scripts/**/*.ts"],
			"ignoreDependencies": ["@mailwoman/neural-weights-en-us"]
		},
		"packages/registry": {
			"entry": ["lib/index.ts", "lib/cli.ts", "lib/models/**/*.ts", "lib/tools/**/*.ts"]
		},
		"packages/tile-worker": {
			"entry": ["lib/index.ts", "lib/_worker.ts"]
		},
		"docs": {
			"entry": [
				"docusaurus.config.ts",
				"sidebars.ts",
				"plugins/**/*.ts",
				"scripts/**/*.{ts,mts}",
				"src/**/*.{js,ts,tsx}",
				"static/**/*.{js,mjs,ts}"
			]
		},
		"packages/release-kit": {
			"entry": ["lib/index.ts", "lib/registry.ts"]
		},
		"packages/repo-health": {
			"entry": ["lib/index.ts", "lib/registry.ts"],
			"ignoreDependencies": ["@vvago/vale"]
		},
		"packages/ops-cli": {
			"entry": ["lib/index.ts", "lib/cli.ts"]
		}
	}
}
