{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [
		"corpus-python/scripts/**/*.ts",
		"docker/server.ts",
		"docs/**/*.mdx",
		"docs/.agents/**",
		"docs/build/**",
		"config/vale/fixtures/**",
		"packages/mailwoman/cli/commands/**/*.tsx",
		"packages/sentencepiece-wasm/sentencepiece.mjs",
		"packages/*/out/**"
	],
	"ignoreBinaries": ["ogr2ogr", "rg", "script", "uv", "uvx", "wrangler"],
	"ignoreDependencies": ["@duckdb/node-api", "ts-morph", "onnxruntime-web", "@vvago/vale"],
	"workspaces": {
		".": {
			"entry": [
				"corpus-python/scripts/**/*.ts",
				"docker/server.ts",
				"*.config.ts",
				"oxlint.plugin.ts",
				"config/oxlint/fix-changed.ts",
				"config/vale/lint-prose.ts",
				"config/vale/check-rules.ts",
				"config/vale/fixtures/clean.ts",
				"config/vale/fixtures/dirty.ts",
				"dependency-cruiser.config.mjs",
				"lib/dev-mcp/index.ts",
				"lib/dev-mcp/cli.ts",
				"lib/dev-mcp/worker.ts",
				"lib/dev-mcp/hooks/**/*.ts",
				"lib/release-kit/index.ts",
				"lib/release-kit/registry.ts",
				"lib/repo-health/index.ts",
				"lib/repo-health/registry.ts",
				"lib/ops-cli/index.ts",
				"lib/ops-cli/cli.ts",
				"lib/release-mcp/index.ts",
				"lib/release-mcp/cli.ts",
				"lib/**/*.test.ts",
				"lib/**/*.test.tsx",
				"vitest.fast.config.ts",
				"vitest.full.config.ts",
				"vitest.slow.config.ts"
			]
		},
		"packages/*": {
			"entry": ["lib/index.ts", "lib/cli.ts", "cli/main.ts", "sdk/**/*.ts", "tools/**/*.ts", "lib/tools/**/*.ts"]
		},
		"packages/mailwoman": {
			"entry": [
				"lib/index.ts",
				"cli/main.ts",
				"cli/commands/**/*.tsx",
				"cli/kit/weights-guard.tsx",
				"tools/**/*.ts",
				"lib/geocode/worker.ts",
				"lib/test-fixtures/**/*"
			],
			"ignoreDependencies": ["@mailwoman/neural-weights-en-us"]
		},
		"packages/api-kit": {
			"entry": ["lib/index.ts", "test/fixtures/**/*.ts"]
		},
		"packages/react": {
			"entry": ["lib/index.ts", "styleframe.config.ts"]
		},
		"packages/astrogeology": {
			"entry": ["lib/cli.ts", "lib/commands/*.tsx"],
			"ignoreDependencies": ["wrangler"]
		},
		"packages/{fastify,libpostal,mcp,nominatim,photon}": {
			"entry": ["lib/index.ts", "cli/main.ts", "tools/**/*.ts"],
			"ignoreDependencies": ["@mailwoman/neural", "@mailwoman/neural-weights-en-us"]
		},
		"packages/neural-weights-*": {
			"entry": ["index.ts", "scripts/**/*.ts"],
			"ignoreDependencies": ["@mailwoman/neural-weights-en-us", "@mailwoman/neural-weights-cjk"]
		},
		"packages/registry": {
			"entry": ["lib/index.ts", "lib/cli.ts", "lib/models/**/*.ts", "tools/**/*.ts"]
		},
		"packages/tile-worker": {
			"entry": ["lib/index.ts", "lib/_worker.ts"],
			"ignoreDependencies": ["wrangler"]
		},
		"packages/earth": {
			"entry": [
				"lib/main.tsx",
				"lib/service-worker.ts",
				"vite.config.ts",
				"playwright.config.ts",
				"test/browser/**/*.ts"
			]
		},
		"packages/planetary": {
			"entry": [
				"lib/main.tsx",
				"lib/service-worker.ts",
				"vite.config.ts",
				"playwright.config.ts",
				"test/browser/**/*.ts"
			],
			"vite": false
		},
		"packages/license-worker": {
			"entry": ["lib/index.ts", "test/**/*.ts", "vitest.config.ts"],
			"ignoreDependencies": ["@cloudflare/vitest-pool-workers", "cloudflare", "wrangler"]
		},
		"docs": {
			"entry": [
				"docusaurus.config.ts",
				"sidebars.ts",
				"plugins/**/*.ts",
				"scripts/**/*.{ts,mts}",
				"src/**/*.{js,ts,tsx}",
				"static/**/*.{js,mjs,ts}"
			],
			"ignoreDependencies": ["@mailwoman/cartographer"]
		}
	}
}
