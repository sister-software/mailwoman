{
	// The toolshed's project, IN `tsc -b`'s graph so `yarn compile` covers it. `composite` requires declaration output,
	// and `emitDeclarationOnly` is how that is satisfied without emitting JavaScript: `scripts/` is run from source under
	// node's type stripping, so the `.d.ts` files are build state, not shipped artifacts.
	//
	// It was outside the graph before, reachable only through `yarn typecheck:scripts`, which is how a type error here
	// could survive every `yarn compile`. Scoped to .ts/.tsx (the repo bans .mjs).
	"extends": "@sister.software/tsconfig/node",
	"compilerOptions": {
		"composite": true,
		"erasableSyntaxOnly": true,
		"emitDeclarationOnly": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": false,
		"incremental": true,
		"checkJs": false,
		"allowJs": false,
		"rootDir": ".",
		"outDir": "./out"
	},
	"include": ["./**/*.ts", "./**/*.tsx"],
	// `diagnostic/` and `scratchpad/` are the throwaway namespaces (.gitignore'd);
	// excluding them keeps `yarn typecheck:scripts` clean against local scratch as well as in CI.
	// `demo-cascade-smoke.ts` imports the docs-app browser source (`docs/src/shared/*`) by relative
	// path; under this node module config TS mis-detects those ESM files as CommonJS (TS1287). It's a
	// runtime smoke test (exercised by promotion-gate). Follow-up: extract the shared cascade logic
	// into a package so both the demo and the smoke test import it across a clean boundary.
	"exclude": [
		"./**/out/**",
		"./**/node_modules/**",
		"./diagnostic/**",
		"./scratchpad/**",
		"./eval/demo-cascade-smoke.ts",
		"./**/*.test.ts",
		"./**/*.test.tsx"
	]
}
