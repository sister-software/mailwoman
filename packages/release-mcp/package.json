{
	"name": "@mailwoman/release-mcp",
	"version": "9.2.0",
	"private": true,
	"description": "Maintainer-only MCP server over the release-kit registry — every read and local-write release operation as a tool with its declared effect; the two publishing operations stay off the tool list unless the operator starts the server with --allow-external-write.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/release-mcp"
	},
	"bin": {
		"mwrelease-mcp": "./lib/cli.ts"
	},
	"files": [
		"lib",
		"out",
		"README.md"
	],
	"type": "module",
	"imports": {
		"#*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		}
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/release-kit": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"path-ts": "^2.3.0",
		"zod": "^4.5.4"
	}
}
