{
	"name": "@mailwoman/gazetteer",
	"version": "10.7.0",
	"description": "Who's On First readers and the gazetteer build pipeline: placetypes, hierarchies, repo sync, and the admin, postcode, POI and address layers the resolver reads.",
	"keywords": [
		"gazetteer",
		"placetype",
		"whosonfirst",
		"wof"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/gazetteer"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"lib/**/*.ts",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1155.0",
		"@aws-sdk/lib-storage": "^3.1155.0",
		"@mailwoman/ban": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/corpus": "workspace:*",
		"@mailwoman/dictionaries": "workspace:*",
		"@mailwoman/evidence": "workspace:*",
		"@mailwoman/match": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/osm": "workspace:*",
		"@mailwoman/poi-taxonomy": "workspace:*",
		"@mailwoman/postcode": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"d3-color": "^3.1.0",
		"d3-scale-chromatic": "^3.1.0",
		"h3-js": "^4.5.0",
		"kysely": "^0.29.7",
		"mailwoman": "workspace:*",
		"path-ts": "^2.5.0",
		"spliterator": "^9.3.0"
	},
	"devDependencies": {
		"@types/d3-color": "^3.1.3",
		"@types/d3-scale-chromatic": "^3.1.0"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
