	"sources": {
		"law": {
			"citation": "The Philippine Standard Geographic Code of the Philippine Statistics Authority divides the country into 18 administrative regions, each a group of provinces and independent cities. Republic Act No. 11054 of 2018 formed Bangsamoro, and Republic Act No. 12000 of 2024 formed the Negros Island Region.",
			"url": "https://psa.gov.ph/classification/psgc"
		},
		"units": {
			"citation": "Wikidata, this region's item (an instance of region of the Philippines, Q24698): English label, item id and ISO 3166-2 code where it holds one. The GeoNames id is the region's row in GeoNames admin1CodesASCII.txt.",
			"url": "https://www.wikidata.org/wiki/Q24698"
		},
		"membership": {
			"citation": "A province or city record is assigned to the region its Wikidata item is located in (P131), read on 2026-11-26, which covers 88 of the 103 records. The other 15 hold a wd:id that isn't the place's own item and are assigned to the region GeoNames files most of the populated places inside their boundary under. Bacolod follows Republic Act No. 12000 into the Negros Island Region."
		}
	},
