	"sources": {
		"law": {
			"citation": "Administratīvo teritoriju un apdzīvoto vietu likums of 2020, whose annex lists the municipalities in effect from 1 July 2021 and the towns and parishes of each. Varakļāni municipality joined Madona municipality on 1 July 2025.",
			"url": "https://likumi.lv/ta/id/315654"
		},
		"units": {
			"citation": "Wikidata, the current municipality whose ISO 3166-2 code (P300) is this unit's: Latvian and English labels, item id and code. The GeoNames id is the unit's row in GeoNames admin1CodesASCII.txt.",
			"url": "https://www.wikidata.org/wiki/Property:P300"
		},
		"membership": {
			"citation": "Each former municipality is assigned to the municipality that GeoNames files most of the populated places inside its boundary under, counted on 2026-11-26. Strenči, Rauna and Varakļāni are assigned as the law's annex lists them."
		}
