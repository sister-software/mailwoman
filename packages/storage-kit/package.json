{
	"name": "@mailwoman/storage-kit",
	"version": "9.2.0",
	"private": true,
	"description": "Storage operations as a registry — plan, prepare, verify, status for the data-root volume — consumed through adapters (the private mwops CLI), never run as files.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/storage-kit"
	},
	"files": [
		"lib",
		"out",
		"README.md"
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./registry": {
			"types": "./out/registry.d.ts",
			"node": "./lib/registry.ts",
			"default": "./out/registry.js"
		},
		"./sudo": {
			"types": "./out/sudo.d.ts",
			"node": "./lib/sudo.ts",
			"default": "./out/sudo.js"
		}
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"zod": "^4.6.5",
		"zx": "^8.8.5"
	}
}
