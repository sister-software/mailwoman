{
	"name": "@mailwoman/neural",
	"version": "10.1.0",
	"description": "Mailwoman neural classifier runtime: SentencePiece tokenizer + ONNX inference + decoder wiring.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/neural"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#postcode": {
			"types": "./out/postcode.d.ts",
			"node": "./lib/postcode.ts",
			"default": "./out/postcode.js"
		},
		"#span": {
			"types": "./out/span.d.ts",
			"node": "./lib/span.ts",
			"default": "./out/span.js"
		},
		"#classifier": {
			"types": "./out/classifier.d.ts",
			"node": "./lib/classifier.ts",
			"default": "./out/classifier.js"
		},
		"#pair": {
			"types": "./out/pair.d.ts",
			"node": "./lib/pair.ts",
			"default": "./out/pair.js"
		},
		"#placetype": {
			"types": "./out/placetype.d.ts",
			"node": "./lib/placetype.ts",
			"default": "./out/placetype.js"
		},
		"#onnx-runner": {
			"types": "./out/onnx/runner.d.ts",
			"browser": "./out/onnx/runner/browser.js",
			"node": "./lib/onnx/runner.ts",
			"default": "./out/onnx/runner.js"
		},
		"#classifier/loader": {
			"types": "./out/classifier/loader.d.ts",
			"browser": "./out/classifier/loader/browser.js",
			"node": "./lib/classifier/loader.ts",
			"default": "./out/classifier/loader.js"
		},
		"#weights": {
			"types": "./out/weights.d.ts",
			"node": "./lib/weights.ts",
			"default": "./out/weights.js"
		},
		"#weights/families": {
			"types": "./out/weights/families.d.ts",
			"node": "./lib/weights/families.ts",
			"default": "./out/weights/families.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./onnx-runner": {
			"types": "./out/onnx/runner.d.ts",
			"browser": "./out/onnx/runner/browser.js",
			"node": "./lib/onnx/runner.ts",
			"default": "./out/onnx/runner.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/ancestrie": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/locale-hint": "workspace:*",
		"@mailwoman/normalize": "workspace:*",
		"@mailwoman/query-shape": "workspace:*",
		"@mailwoman/sentencepiece-wasm": "workspace:*",
		"path-ts": "^2.5.0",
		"spliterator": "^9.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"esbuild": "0.28.2",
		"onnxruntime-node": "^1.30.0",
		"onnxruntime-web": "1.30.0",
		"playwright": "^1.63.0"
	},
	"peerDependencies": {
		"onnxruntime-node": "^1.26.0",
		"onnxruntime-web": "*"
	},
	"peerDependenciesMeta": {
		"onnxruntime-node": {
			"optional": true
		},
		"onnxruntime-web": {
			"optional": true
		}
	}
}
