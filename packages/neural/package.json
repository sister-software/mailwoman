{
	"name": "@mailwoman/neural",
	"version": "9.4.0",
	"description": "Mailwoman neural classifier runtime: SentencePiece tokenizer + ONNX inference + decoder wiring.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/neural"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#postcode": {
			"types": "./out/postcode/index.d.ts",
			"node": "./lib/postcode/index.ts",
			"default": "./out/postcode/index.js"
		},
		"#span": {
			"types": "./out/span/index.d.ts",
			"node": "./lib/span/index.ts",
			"default": "./out/span/index.js"
		},
		"#classifier": {
			"types": "./out/classifier/index.d.ts",
			"node": "./lib/classifier/index.ts",
			"default": "./out/classifier/index.js"
		},
		"#pair": {
			"types": "./out/pair/index.d.ts",
			"node": "./lib/pair/index.ts",
			"default": "./out/pair/index.js"
		},
