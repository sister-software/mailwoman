{
	"name": "@mailwoman/resolver-wof-sqlite",
	"version": "10.1.0",
	"description": "Who's On First SQLite resolver — FTS5-backed PlaceLookup that resolves text queries to WOF place IDs + coordinates. Optional dependency for callers who want geocoding.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/resolver-wof-sqlite"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#fst": {
			"types": "./out/fst.d.ts",
			"node": "./lib/fst.ts",
			"default": "./out/fst.js"
		},
		"#street": {
			"types": "./out/street.d.ts",
			"node": "./lib/street.ts",
			"default": "./out/street.js"
		},
		"#postal": {
			"types": "./out/postal.d.ts",
			"node": "./lib/postal.ts",
			"default": "./out/postal.js"
		},
		"#address": {
			"types": "./out/address.d.ts",
			"node": "./lib/address.ts",
			"default": "./out/address.js"
		},
		"#uprn": {
			"types": "./out/uprn.d.ts",
			"node": "./lib/uprn.ts",
			"default": "./out/uprn.js"
		},
		"#nsul": {
			"types": "./out/nsul.d.ts",
			"node": "./lib/nsul.ts",
			"default": "./out/nsul.js"
		},
		"#poi": {
			"types": "./out/poi.d.ts",
			"node": "./lib/poi.ts",
			"default": "./out/poi.js"
		},
		"#geonames": {
			"types": "./out/geonames.d.ts",
			"node": "./lib/geonames.ts",
			"default": "./out/geonames.js"
		},
		"#fts": {
			"types": "./out/fts.d.ts",
			"node": "./lib/fts.ts",
			"default": "./out/fts.js"
		},
		"#convention": {
			"types": "./out/convention.d.ts",
			"node": "./lib/convention.ts",
			"default": "./out/convention.js"
		},
		"#ancestry": {
			"types": "./out/ancestry.d.ts",
			"node": "./lib/ancestry.ts",
			"default": "./out/ancestry.js"
		},
		"#candidate/alias-bags": {
			"types": "./out/candidate/alias-bags.d.ts",
			"node": "./lib/candidate/alias-bags.ts",
			"default": "./out/candidate/alias-bags.js"
		},
		"#candidate/name-roles": {
			"types": "./out/candidate/name-roles.d.ts",
			"node": "./lib/candidate/name-roles.ts",
			"default": "./out/candidate/name-roles.js"
		},
		"#candidate/place-attrs": {
			"types": "./out/candidate/place-attrs.d.ts",
			"node": "./lib/candidate/place-attrs.ts",
			"default": "./out/candidate/place-attrs.js"
		},
		"#sqlite-utils": {
			"types": "./out/sqlite/utils.d.ts",
			"node": "./lib/sqlite/utils.ts",
			"default": "./out/sqlite/utils.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/ancestrie": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/evidence": "workspace:*",
		"@mailwoman/match": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"h3-js": "^4.5.0",
		"kysely": "^0.29.6",
		"path-ts": "^2.5.0",
		"spliterator": "^8.1.0",
		"type-fest": "^5.10.0",
		"zod": "^4.6.5"
	}
}
