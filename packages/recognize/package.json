{
	"name": "@mailwoman/recognize",
	"version": "11.1.0",
	"private": true,
	"description": "A declarative grammar library for the formal languages in geographic queries, with a deterministic, versioned JSON intermediate representation. The compiler, the matcher and the WebAssembly adapter arrive in later phases.",
	"keywords": [
		"grammar",
		"recognition"
	],
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/recognize"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"tools/**/*.ts",
		"data/ir/*.json",
		"definitions/*.json",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"sideEffects": [
		"./tools/**/*.run.ts",
		"./out/tools/**/*.run.js"
	],
	"imports": {
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.6"
	}
}
