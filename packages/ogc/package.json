{
	"name": "@mailwoman/ogc",
	"version": "11.2.0",
	"description": "OGC API adapter for the Mailwoman engine. Serves the OGC API Common landing page, conformance declaration, API definition and collections, gazetteer places as OGC API Features items, and forward geocoding at /search in the form of PDOK's Location API. Run it with `npx @mailwoman/ogc serve`.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/ogc"
	},
	"bin": "./out/cli/main.js",
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"cli/**/*.ts",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#cli/*": {
			"types": "./out/cli/*.d.ts",
			"node": "./cli/*.ts",
			"default": "./out/cli/*.js"
		},
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./cli/*": {
			"types": "./out/cli/*.d.ts",
			"node": "./cli/*.ts",
			"default": "./out/cli/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@mailwoman/api": "workspace:*",
		"@mailwoman/api-kit": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"hono": "^4.13.14",
		"mailwoman": "workspace:*",
		"path-ts": "^2.5.0",
		"zod": "^4.6.7"
	}
}
