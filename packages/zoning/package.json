{
	"name": "@mailwoman/zoning",
	"version": "9.4.0",
	"description": "Irish Generalised Zoning Types (MyPlan.ie) — acquisition, build, and the zoning-ireland.db layer reader",
	"keywords": [
		"geospatial",
		"h3",
		"ireland",
		"land-use",
		"myplan",
		"planning",
		"zoning"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/zoning"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./scripts/*": {
			"types": "./out/scripts/*.d.ts",
			"node": "./lib/scripts/*.ts",
			"default": "./out/scripts/*.js"
		},
		"./schema": {
			"types": "./out/schema.d.ts",
			"node": "./lib/schema.ts",
			"default": "./out/schema.js"
		},
		"./vocabulary": {
			"types": "./out/vocabulary.d.ts",
			"node": "./lib/vocabulary.ts",
			"default": "./out/vocabulary.js"
		},
		"./test-kit": {
			"types": "./out/test-kit.d.ts",
			"node": "./lib/test-kit.ts",
			"default": "./out/test-kit.js"
		},
		"./rings": {
			"types": "./out/rings.d.ts",
			"node": "./lib/rings.ts",
			"default": "./out/rings.js"
		},
		"./ring-roles": {
			"types": "./out/ring-roles.d.ts",
			"node": "./lib/ring-roles.ts",
			"default": "./out/ring-roles.js"
		},
		"./sdk": {
			"types": "./out/sdk/index.d.ts",
			"node": "./lib/sdk/index.ts",
			"default": "./out/sdk/index.js"
		},
		"./sdk/build-zoning": {
			"types": "./out/sdk/build-zoning.d.ts",
			"node": "./lib/sdk/build-zoning.ts",
			"default": "./out/sdk/build-zoning.js"
		},
		"./sdk/cells": {
			"types": "./out/sdk/cells.d.ts",
			"node": "./lib/sdk/cells.ts",
			"default": "./out/sdk/cells.js"
		},
		"./sdk/client": {
			"types": "./out/sdk/client.d.ts",
			"node": "./lib/sdk/client.ts",
			"default": "./out/sdk/client.js"
		},
		"./sdk/download": {
			"types": "./out/sdk/download.d.ts",
			"node": "./lib/sdk/download.ts",
			"default": "./out/sdk/download.js"
		},
		"./sdk/ingest": {
			"types": "./out/sdk/ingest/index.d.ts",
			"node": "./lib/sdk/ingest/index.ts",
			"default": "./out/sdk/ingest/index.js"
		},
		"./sdk/ingest-chunk": {
			"types": "./out/sdk/ingest/chunk.d.ts",
			"node": "./lib/sdk/ingest/chunk.ts",
			"default": "./out/sdk/ingest/chunk.js"
		},
		"./sdk/measure-resolutions": {
			"types": "./out/sdk/measure-resolutions.d.ts",
			"node": "./lib/sdk/measure-resolutions.ts",
			"default": "./out/sdk/measure-resolutions.js"
		},
		"./sdk/verify": {
			"types": "./out/sdk/verify.d.ts",
			"node": "./lib/sdk/verify.ts",
			"default": "./out/sdk/verify.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/evidence": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"h3-js": "^4.5.0",
		"kysely": "^0.29.5",
		"path-ts": "^2.3.0",
		"spliterator": "^7.3.0"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
