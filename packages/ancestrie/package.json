			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/ancestrie"
	},
	"files": [
		"out/",
		"*.ts",
		"**/*.ts",
		"!*.test.ts",
		"!**/*.test.ts"
	],
