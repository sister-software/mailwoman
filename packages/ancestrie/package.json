{
	"name": "@mailwoman/ancestrie",
	"version": "9.2.0",
	"description": "A materialized trie over an ancestry graph — one prefix walk yields lexical continuations, ranks, and containment lineage from a single static artifact.",
	"keywords": [
		"ancestry",
		"autocomplete",
		"hierarchy",
		"trie"
	],
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/ancestrie"
	},
	"files": [
		"out/",
		"*.ts",
		"**/*.ts",
		"!*.test.ts",
		"!**/*.test.ts",
		"!test/**"
	],
	"type": "module",
	"imports": {
		"#*": {
			"node": "./*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./autocomplete": {
			"node": "./autocomplete.ts",
			"default": "./out/autocomplete.js",
			"types": "./out/autocomplete.d.ts"
		},
		"./builder": {
			"node": "./builder.ts",
			"default": "./out/builder.js",
			"types": "./out/builder.d.ts"
		},
		"./reader": {
			"node": "./reader.ts",
			"default": "./out/reader.js",
			"types": "./out/reader.d.ts"
		},
		"./types": {
			"node": "./types.ts",
			"default": "./out/types.js",
			"types": "./out/types.d.ts"
		},
		"./format": {
			"node": "./format.ts",
			"default": "./out/format.js",
			"types": "./out/format.d.ts"
		}
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
