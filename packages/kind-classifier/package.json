{
	"name": "@mailwoman/kind-classifier",
	"version": "9.4.0",
	"description": "Stage 2.5 of the runtime pipeline — categorize inputs by query shape (postcode_only / locality_only / structured_address / intersection / po_box / landmark / vague). Rule-based for v1.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/kind-classifier"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./classify": {
			"types": "./out/classify.d.ts",
			"node": "./lib/classify.ts",
			"default": "./out/classify.js"
		},
		"./intent-rules": {
			"types": "./out/intent-rules.d.ts",
			"node": "./lib/intent-rules.ts",
			"default": "./out/intent-rules.js"
		},
		"./rules": {
			"types": "./out/rules.d.ts",
			"node": "./lib/rules.ts",
			"default": "./out/rules.js"
		},
		"./poi": {
			"types": "./out/poi.d.ts",
			"node": "./lib/poi.ts",
			"default": "./out/poi.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/query-shape": "workspace:*"
	}
}
