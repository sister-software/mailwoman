{
	"name": "@mailwoman/neural-weights-it-it",
	"version": "9.3.0",
	"description": "it-IT weights overlay for mailwoman — data-only; shares the base model with @mailwoman/neural-weights-en-us.",
	"license": "AGPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/neural-weights-it-it"
	},
	"files": [
		"model-card.json",
		"pair-index-it.bin",
		"anchor-lexicon-v1.json",
		"locality-surface-lexicon-v7.json",
		"street-type-lexicon-v3.json",
		"country-surface-lexicon-v1.json",
		"README.md",
		"*.ts",
		"**/*.ts",
		"!*.test.ts",
		"!**/*.test.ts",
		"!scripts/**",
		"!test/**"
	],
	"type": "module",
	"imports": {
		"#*": {
			"node": "./*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./*": "./*"
	},
	"dependencies": {
		"@mailwoman/neural-weights-en-us": "workspace:*"
	},
	"devDependencies": {
		"@mailwoman/resolver-wof-sqlite": "workspace:*"
	},
	"mailwoman": {
		"baseWeights": "@mailwoman/neural-weights-en-us"
	}
}
