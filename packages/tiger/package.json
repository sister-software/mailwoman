{
	"name": "@mailwoman/tiger",
	"version": "9.2.0",
	"description": "US Census TIGER/Line data processing and analysis.",
	"keywords": [
		"census",
		"geospatial",
		"tiger"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/tiger"
	},
	"files": [
		"out/",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!__snapshots__/",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#index": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"#*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./sdk": {
			"node": "./lib/sdk/index.ts",
			"default": "./out/sdk/index.js",
			"types": "./out/sdk/index.d.ts"
		},
		"./tools": {
			"node": "./lib/tools/index.ts",
			"default": "./out/tools/index.js",
			"types": "./out/tools/index.d.ts"
		},
		".": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./sdk/schema": {
			"node": "./lib/sdk/schema.ts",
			"default": "./out/sdk/schema.js",
			"types": "./out/sdk/schema.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node ./out/sdk/TIGERService.test.js"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@turf/boolean-contains": "^7.4.0",
		"kysely": "^0.29.5",
		"path-ts": "^2.3.0",
		"spliterator": "^6.4.1",
		"type-fest": "^5.9.0"
	},
	"devDependencies": {
		"@protomaps/basemaps": "^5.7.2"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
