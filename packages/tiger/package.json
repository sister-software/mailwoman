{
	"name": "@mailwoman/tiger",
	"version": "10.0.0",
	"description": "US Census TIGER/Line data processing and analysis.",
	"keywords": [
		"census",
		"geospatial",
		"tiger"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/tiger"
	},
	"files": [
		"out/",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"sdk/**/*.ts",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!__snapshots__/"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#index": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "node ./out/sdk/TIGERService.test.js"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@turf/boolean-contains": "^7.4.0",
		"kysely": "^0.29.5",
		"path-ts": "^2.5.0",
		"spliterator": "^8.1.0",
		"type-fest": "^5.9.0"
	},
	"devDependencies": {
		"@protomaps/basemaps": "^5.7.2"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
