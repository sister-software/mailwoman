{
	"name": "@mailwoman/browser",
	"version": "10.5.0",
	"private": true,
	"description": "Shared browser automation for data acquisition and agent tools.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"files": [
		"lib/**/*.ts",
		"out/",
		"!**/*.test.ts"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./package.json": "./package.json",
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@playwright/mcp": "0.0.83",
		"playwright": "^1.64.1",
		"playwright-extra": "4.3.6",
		"puppeteer-extra-plugin-stealth": "2.11.2"
	},
	"devDependencies": {
		"@types/node": "^26.6.6"
	}
}
