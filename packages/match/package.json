{
	"name": "@mailwoman/match",
	"version": "9.2.0",
	"description": "The geocode-first record matcher: block → score → cluster. This first cut ships the string comparators (Jaro / Jaro-Winkler + an edit-distance fallback for compound surnames) that the Fellegi-Sunter scorer is built on.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/match"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./blocking": {
			"node": "./lib/blocking.ts",
			"default": "./out/blocking.js",
			"types": "./out/blocking.d.ts"
		},
		"./clustering": {
			"node": "./lib/clustering.ts",
			"default": "./out/clustering.js",
			"types": "./out/clustering.d.ts"
		},
		"./comparators": {
			"node": "./lib/comparators.ts",
			"default": "./out/comparators.js",
			"types": "./out/comparators.d.ts"
		},
		"./distance": {
			"node": "./lib/distance.ts",
			"default": "./out/distance.js",
			"types": "./out/distance.d.ts"
		},
		"./fellegi-sunter": {
			"node": "./lib/fellegi-sunter.ts",
			"default": "./out/fellegi-sunter.js",
			"types": "./out/fellegi-sunter.d.ts"
		},
		"./em": {
			"node": "./lib/em.ts",
			"default": "./out/em.js",
			"types": "./out/em.d.ts"
		},
		"./tf": {
			"node": "./lib/tf.ts",
			"default": "./out/tf.js",
			"types": "./out/tf.d.ts"
		},
		"./gbt": {
			"node": "./lib/gbt.ts",
			"default": "./out/gbt.js",
			"types": "./out/gbt.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/spatial": "workspace:*",
		"fastest-levenshtein": "^1.0.16"
	},
	"devDependencies": {
		"@types/node": ">=26.4.0"
	}
}
