{
	"name": "@mailwoman/spatial",
	"version": "11.0.0",
	"description": "Spatial analysis, geocoding, and other geo-related utilities.",
	"keywords": [
		"geo",
		"spatial"
	],
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/spatial"
	},
	"files": [
		"out/",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!__snapshots__/"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/postcode": "workspace:*",
		"@sister.software/h3": "^1.1.0",
		"@types/google.maps": "^3.66.9",
		"geo-coordinates-parser": "^1.7.4",
		"path-ts": "^2.5.0",
		"spliterator": "^10.1.1",
		"wkx": "^0.5.0"
	},
	"devDependencies": {
		"@mailwoman/annotations": "workspace:*",
		"type-fest": "^5.10.0"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
