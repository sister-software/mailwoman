{
	"name": "@mailwoman/spatial",
	"version": "9.3.0",
	"description": "Spatial analysis, geocoding, and other geo-related utilities.",
	"keywords": [
		"geo",
		"spatial"
	],
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/spatial"
	},
	"files": [
		"out/",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!__snapshots__/",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./coordinate-bounds": {
			"node": "./lib/coordinate-bounds.ts",
			"default": "./out/coordinate-bounds.js",
			"types": "./out/coordinate-bounds.d.ts"
		},
		".": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./coordinate-formats": {
			"node": "./lib/coordinate-formats.ts",
			"default": "./out/coordinate-formats.js",
			"types": "./out/coordinate-formats.d.ts"
		},
		"./open-location-code": {
			"node": "./lib/open-location-code.ts",
			"default": "./out/open-location-code.js",
			"types": "./out/open-location-code.d.ts"
		},
		"./geometries/polygon": {
			"node": "./lib/geometries/polygon.ts",
			"default": "./out/geometries/polygon.js",
			"types": "./out/geometries/polygon.d.ts"
		},
		"./h3/cell": {
			"node": "./lib/h3/cell.ts",
			"default": "./out/h3/cell.js",
			"types": "./out/h3/cell.d.ts"
		},
		"./h3/polygon-cells": {
			"node": "./lib/h3/polygon-cells.ts",
			"default": "./out/h3/polygon-cells.js",
			"types": "./out/h3/polygon-cells.d.ts"
		},
		"./geometries/ring-blob": {
			"node": "./lib/geometries/ring-blob.ts",
			"default": "./out/geometries/ring-blob.js",
			"types": "./out/geometries/ring-blob.d.ts"
		},
		"./projection-transform": {
			"node": "./lib/projection-transform.ts",
			"default": "./out/projection-transform.js",
			"types": "./out/projection-transform.d.ts"
		},
		"./well-known-text": {
			"node": "./lib/well-known-text.ts",
			"default": "./out/well-known-text.js",
			"types": "./out/well-known-text.d.ts"
		},
		"./tools/ogr": {
			"node": "./lib/tools/ogr.ts",
			"default": "./out/tools/ogr.js",
			"types": "./out/tools/ogr.d.ts"
		},
		"./h3/coverage": {
			"node": "./lib/h3/coverage.ts",
			"default": "./out/h3/coverage.js",
			"types": "./out/h3/coverage.d.ts"
		},
		"./tools/ogr-stream": {
			"node": "./lib/tools/ogr-stream.ts",
			"default": "./out/tools/ogr-stream.js",
			"types": "./out/tools/ogr-stream.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"geo-coordinates-parser": "^1.7.4",
		"h3-js": "^4.5.0",
		"wkx": "^0.5.0"
	},
	"devDependencies": {
		"@googlemaps/google-maps-services-js": "^3.4.2",
		"@mailwoman/annotations": "workspace:*",
		"type-fest": "^5.9.0"
	},
	"optionalDependencies": {
		"@googlemaps/google-maps-services-js": "^3.4.2",
		"@types/google.maps": "^3.66.2"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
