{
	"name": "@mailwoman/service-worker-cache",
	"version": "0.0.0",
	"private": true,
	"description": "Workbox route handlers and plugins for Earth's service worker: validated byte-range chunks, torn-body refusal and release pruning.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/service-worker-cache"
	},
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"dependencies": {
		"workbox-core": "^7.4.1"
	}
}
