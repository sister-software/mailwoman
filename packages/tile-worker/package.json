		"@mailwoman/api-worker": "workspace:*",
		"@mailwoman/cartographer": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"hono": "^4.13.13",
		"pmtiles": "^4.5.0"
	},
	"devDependencies": {
		"wrangler": "^4.151.0"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
