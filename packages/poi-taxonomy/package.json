{
	"name": "@mailwoman/poi-taxonomy",
	"version": "10.1.0",
	"description": "POI category taxonomy + phrase lexicon — Overture category snapshot, infrastructure extension namespace, and the synonym table mapping query phrases ('drinking fountain', 'fiber hut') to category ids.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/poi-taxonomy"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"data/**/*.json",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./data/*.json": "./data/*.json",
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"path-ts": "^2.5.0"
	},
	"devDependencies": {
		"spliterator": "^9.0.0"
	}
}
