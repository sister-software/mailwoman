{
	"name": "@mailwoman/poi-taxonomy",
	"version": "9.4.0",
	"description": "POI category taxonomy + phrase lexicon — Overture category snapshot, infrastructure extension namespace, and the synonym table mapping query phrases ('drinking fountain', 'fiber hut') to category ids.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/poi-taxonomy"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"data/**/*.json",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!lib/scripts/**",
		"!test/**"
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./table": {
			"types": "./out/table.d.ts",
			"node": "./lib/table.ts",
			"default": "./out/table.js"
		},
		"./overpass": {
			"types": "./out/overpass.d.ts",
			"node": "./lib/overpass.ts",
			"default": "./out/overpass.js"
		},
		"./venue-word-hints": {
			"types": "./out/venue-word-hints.d.ts",
			"node": "./lib/venue-word-hints.ts",
			"default": "./out/venue-word-hints.js"
		},
		"./data/*.json": "./data/*.json",
		"./brands": {
			"types": "./out/brands.d.ts",
			"node": "./lib/brands.ts",
			"default": "./out/brands.js"
		},
		"./lookup": {
			"types": "./out/lookup.d.ts",
			"node": "./lib/lookup.ts",
			"default": "./out/lookup.js"
		},
		"./scripts/generate-taxonomy": {
			"types": "./out/scripts/generate-taxonomy.d.ts",
			"node": "./lib/scripts/generate-taxonomy.ts",
			"default": "./out/scripts/generate-taxonomy.js"
		},
		"./types": {
			"types": "./out/types.d.ts",
			"node": "./lib/types.ts",
			"default": "./out/types.js"
		},
		"./packaged-data": {
			"types": "./out/packaged-data.d.ts",
			"node": "./lib/packaged-data.ts",
			"default": "./out/packaged-data.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"path-ts": "^2.3.0"
	},
	"devDependencies": {
		"@mailwoman/core": "workspace:*",
		"spliterator": "^6.4.1"
	}
}
