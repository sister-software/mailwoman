{
	"name": "@mailwoman/nuts-lookup",
	"version": "9.3.0",
	"description": "EU coordinate → NUTS statistical-region codes (levels 1–3). Point-in-polygon over Eurostat GISCO NUTS boundaries in node:sqlite. An @mailwoman/annotations Annotator.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/nuts-lookup"
	},
	"bin": "./out/cli.js",
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./build": {
			"types": "./out/build.d.ts",
			"node": "./lib/build.ts",
			"default": "./out/build.js"
		},
		"./schema": {
			"types": "./out/schema.d.ts",
			"node": "./lib/schema.ts",
			"default": "./out/schema.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/annotations": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*"
	}
}
