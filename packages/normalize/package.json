{
	"name": "@mailwoman/normalize",
	"version": "9.3.0",
	"description": "Stage 1 of the runtime pipeline — deterministic input preprocessing (Unicode NFC, punctuation, whitespace, abbreviation). Pure functions, no ML.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/normalize"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./abbreviations": {
			"types": "./out/abbreviations.d.ts",
			"node": "./lib/abbreviations.ts",
			"default": "./out/abbreviations.js"
		},
		"./cjk": {
			"types": "./out/cjk.d.ts",
			"node": "./lib/cjk.ts",
			"default": "./out/cjk.js"
		},
		"./compute": {
			"types": "./out/compute.d.ts",
			"node": "./lib/compute.ts",
			"default": "./out/compute.js"
		},
		"./nfc": {
			"types": "./out/nfc.d.ts",
			"node": "./lib/nfc.ts",
			"default": "./out/nfc.js"
		},
		"./offset-map": {
			"types": "./out/offset-map.d.ts",
			"node": "./lib/offset-map.ts",
			"default": "./out/offset-map.js"
		},
		"./punctuation": {
			"types": "./out/punctuation.d.ts",
			"node": "./lib/punctuation.ts",
			"default": "./out/punctuation.js"
		},
		"./comma-spacing": {
			"types": "./out/comma-spacing.d.ts",
			"node": "./lib/comma-spacing.ts",
			"default": "./out/comma-spacing.js"
		},
		"./fold": {
			"types": "./out/fold.d.ts",
			"node": "./lib/fold.ts",
			"default": "./out/fold.js"
		},
		"./whitespace": {
			"types": "./out/whitespace.d.ts",
			"node": "./lib/whitespace.ts",
			"default": "./out/whitespace.js"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
