{
	"name": "@mailwoman/normalize",
	"version": "10.1.0",
	"description": "Stage 1 of the runtime pipeline — deterministic input preprocessing (Unicode NFC, punctuation, whitespace, abbreviation). Pure functions, no ML.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/normalize"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"spliterator": "^8.1.0"
	}
}
