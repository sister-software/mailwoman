{
	// The acquisition root. It compiles to `../out/sdk` beside the library's `../out`, and it references the
	// library project because acquisition imports the library and never the reverse.
	"extends": "@sister.software/tsconfig/node",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "../out/sdk",
		"allowSyntheticDefaultImports": true,
		"emitDeclarationOnly": false,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["./**/*"],
	"exclude": ["./**/*.test.ts", "./**/*.test.tsx"],
	"references": [{ "path": ".." }, { "path": "../../core" }]
}
