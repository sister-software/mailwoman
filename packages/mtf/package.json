{
	"name": "@mailwoman/mtf",
	"version": "10.7.0",
	"description": "Multilingual Token Framework: Mailwoman's subword tokenizer, a Rust core compiled to WASM with a TypeScript loader. It reproduces SentencePiece v0.2.2's pieces and offsets on the shipped unigram model and is the tokenizer runtime for @mailwoman/neural.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/mtf"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"tools/**/*.ts",
		"wasm/mtf.wasm",
		"README.md",
		"THIRD_PARTY_NOTICES.md",
		"third-party/**",
		"!**/*.test.ts",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./wasm/mtf.wasm": "./wasm/mtf.wasm",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/query-shape": "workspace:*",
		"path-ts": "^2.5.0",
		"spliterator": "^10.1.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"onnxruntime-node": "^1.30.0"
	},
	"peerDependencies": {
		"onnxruntime-node": "^1.26.0"
	},
	"peerDependenciesMeta": {
		"onnxruntime-node": {
			"optional": true
		}
	}
}
