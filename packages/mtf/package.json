{
	"name": "@mailwoman/mtf",
	"version": "10.7.0",
	"private": true,
	"description": "Multilingual Token Framework: Mailwoman's subword tokenizer, a Rust core compiled to WASM with a TypeScript loader. It will replace @mailwoman/sentencepiece-wasm once it reproduces the shipped model's pieces and offsets.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/mtf"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"tools/**/*.ts",
		"wasm/mtf.wasm",
		"README.md",
		"THIRD_PARTY_NOTICES.md",
		"third-party/**",
		"!**/*.test.ts",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./wasm/mtf.wasm": "./wasm/mtf.wasm",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.5"
	}
}
