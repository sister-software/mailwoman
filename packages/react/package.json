		"#test/act": "./test/act.ts",
		"#test/mocks": "./test/mocks.tsx",
		"#test/render": "./test/render.tsx",
		"#index": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"#map": {
			"types": "./out/map.d.ts",
			"node": "./lib/map.ts",
			"default": "./out/map.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
