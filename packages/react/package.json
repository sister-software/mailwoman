		"!**/*.stories.ts",
		"!**/*.stories.tsx",
		"!.storybook/**",
		"!vitest.config.ts",
		"!out/test/**",
		"!out/storybook-static/**",
		"!storybook-static/**"
	],
	"type": "module",
	"sideEffects": [
		"./styles.css",
		"./fonts.css",
		"./tokens/index.css"
	],
