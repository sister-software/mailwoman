{
	"name": "@mailwoman/react",
	"version": "9.4.0",
	"description": "React components + headless hooks for mailwoman — parse/geocode/POI explorers, Storybook-tested, Docusaurus-independent.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/react"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"styles.css",
		"fonts.css",
		"tokens/index.css",
		"tokens/tokens.json",
		"tokens/tokens.resolver.json",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!**/*.stories.ts",
		"!**/*.stories.tsx",
		"!.storybook/**",
		"!vitest.config.ts",
		"!test/**",
		"!out/test/**",
		"!out/storybook-static/**",
		"!storybook-static/**"
	],
	"type": "module",
	"sideEffects": [
		"./styles.css",
		"./fonts.css",
		"./tokens/index.css"
	],
	"imports": {
		"#test/act": "./test/act.ts",
		"#test/mocks": "./test/mocks.tsx",
		"#test/render": "./test/render.tsx",
		"#index": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"#map": {
			"types": "./out/map/index.d.ts",
			"node": "./lib/map/index.ts",
			"default": "./out/map/index.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./styles.css": "./styles.css",
		"./tokens.css": "./tokens/index.css",
		"./fonts.css": "./fonts.css",
		"./tokens.json": "./tokens/tokens.json",
		".": {
