{
	"name": "@mailwoman/postcode",
	"version": "11.1.0",
	"description": "Postcode evidence: each country's postcode syntax, the spans in a line that have a postcode's shape, and the address systems a postcode's form admits.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/postcode"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"lib/frozen-shapes.json",
		"out/frozen-shapes.json",
		"lib/subregions.json",
		"out/subregions.json"
	],
	"type": "module",
	"sideEffects": [
		"./tools/**/*.run.ts",
		"./out/tools/**/*.run.js"
	],
	"imports": {
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"generate:check": "node tools/generate.run.ts --check",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:workers": "vitest run --config vitest.workers.config.ts"
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/recognize": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.11",
		"@vitest/browser-playwright": "5.0.5",
		"oxfmt": "0.75.0",
		"playwright": "^1.64.1",
		"spliterator": "^10.1.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	}
}
