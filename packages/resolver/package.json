{
	"name": "@mailwoman/resolver",
	"version": "9.2.0",
	"description": "The address resolver: walk an AddressTree, decorate nodes with gazetteer-supplied coordinates + attribution. Backend-agnostic (any ResolverBackend), with the span-rescore + postcode-consistency levers. Lifted out of @mailwoman/core so it can depend on @mailwoman/spatial (haversine) + @mailwoman/codex (USPS directionals) instead of reinventing them; the type contract stays in core so the pipeline composes it without a cycle.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/resolver"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"imports": {
		"#test/backend-name-key": "./test/helpers/backend-name-key.ts"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./resolve": {
			"node": "./resolve.ts",
			"default": "./out/resolve.js",
			"types": "./out/resolve.d.ts"
		},
		"./postcode-country-coherence": {
			"node": "./postcode-country-coherence.ts",
			"default": "./out/postcode-country-coherence.js",
			"types": "./out/postcode-country-coherence.d.ts"
		},
		"./span-rescore": {
			"node": "./span-rescore.ts",
			"default": "./out/span-rescore.js",
			"types": "./out/span-rescore.d.ts"
		},
		"./backend-capabilities": {
			"node": "./backend-capabilities.ts",
			"default": "./out/backend-capabilities.js",
			"types": "./out/backend-capabilities.d.ts"
		},
		"./admin-containment": {
			"node": "./admin-containment.ts",
			"default": "./out/admin-containment.js",
			"types": "./out/admin-containment.d.ts"
		},
		"./admin-winner": {
			"node": "./admin-winner.ts",
			"default": "./out/admin-winner.js",
			"types": "./out/admin-winner.d.ts"
		},
		"./decorate-node": {
			"node": "./decorate-node.ts",
			"default": "./out/decorate-node.js",
			"types": "./out/decorate-node.d.ts"
		},
		"./plausibility": {
			"node": "./plausibility.ts",
			"default": "./out/plausibility.js",
			"types": "./out/plausibility.d.ts"
		},
		"./postcode-prefix": {
			"node": "./postcode-prefix.ts",
			"default": "./out/postcode-prefix.js",
			"types": "./out/postcode-prefix.d.ts"
		},
		"./postcode-shape-coherence": {
			"node": "./postcode-shape-coherence.ts",
			"default": "./out/postcode-shape-coherence.js",
			"types": "./out/postcode-shape-coherence.d.ts"
		},
		"./remote-resolver": {
			"node": "./remote-resolver.ts",
			"default": "./out/remote-resolver.js",
			"types": "./out/remote-resolver.d.ts"
		},
		"./rerank": {
			"node": "./rerank.ts",
			"default": "./out/rerank.js",
			"types": "./out/rerank.d.ts"
		},
		"./street-evidence": {
			"node": "./street-evidence.ts",
			"default": "./out/street-evidence.js",
			"types": "./out/street-evidence.d.ts"
		},
		"./toponym-prior": {
			"node": "./toponym-prior.ts",
			"default": "./out/toponym-prior.js",
			"types": "./out/toponym-prior.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/platform": "workspace:*",
		"@mailwoman/spatial": "workspace:*"
	}
}
