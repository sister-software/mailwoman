{
	"name": "@mailwoman/resolver",
	"version": "10.1.0",
	"description": "The address resolver: walk an AddressTree, decorate nodes with gazetteer-supplied coordinates + attribution. Backend-agnostic (any ResolverBackend), with the span-rescore + postcode-consistency changes. Lifted out of @mailwoman/core so it can depend on @mailwoman/spatial (haversine) + @mailwoman/codex (USPS directionals) instead of reinventing them; the type interface stays in core so the pipeline composes it without a cycle.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/resolver"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#admin": {
			"types": "./out/admin.d.ts",
			"node": "./lib/admin.ts",
			"default": "./out/admin.js"
		},
		"#postcode": {
			"types": "./out/postcode.d.ts",
			"node": "./lib/postcode.ts",
			"default": "./out/postcode.js"
		},
		"#resolve": {
			"types": "./out/resolve.d.ts",
			"node": "./lib/resolve.ts",
			"default": "./out/resolve.js"
		},
		"#street": {
			"types": "./out/street.d.ts",
			"node": "./lib/street.ts",
			"default": "./out/street.js"
		},
		"#test/backend-name-key": "./test/helpers/backend-name-key.ts",
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/evidence": "workspace:*",
		"@mailwoman/query-shape": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"spliterator": "^9.0.0"
	},
	"devDependencies": {
		"path-ts": "^2.5.0"
	}
}
