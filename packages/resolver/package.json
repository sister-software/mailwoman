{
	"name": "@mailwoman/resolver",
	"version": "9.4.0",
	"description": "The address resolver: walk an AddressTree, decorate nodes with gazetteer-supplied coordinates + attribution. Backend-agnostic (any ResolverBackend), with the span-rescore + postcode-consistency changes. Lifted out of @mailwoman/core so it can depend on @mailwoman/spatial (haversine) + @mailwoman/codex (USPS directionals) instead of reinventing them; the type contract stays in core so the pipeline composes it without a cycle.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/resolver"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#admin": {
			"types": "./out/admin/index.d.ts",
			"node": "./lib/admin/index.ts",
			"default": "./out/admin/index.js"
		},
		"#postcode": {
			"types": "./out/postcode/index.d.ts",
			"node": "./lib/postcode/index.ts",
			"default": "./out/postcode/index.js"
		},
		"#resolve": {
			"types": "./out/resolve/index.d.ts",
			"node": "./lib/resolve/index.ts",
			"default": "./out/resolve/index.js"
		},
		"#street": {
			"types": "./out/street/index.d.ts",
			"node": "./lib/street/index.ts",
			"default": "./out/street/index.js"
		},
		"#test/backend-name-key": "./test/helpers/backend-name-key.ts",
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./resolve": {
			"types": "./out/resolve/index.d.ts",
			"node": "./lib/resolve/index.ts",
			"default": "./out/resolve/index.js"
		},
		"./span-rescore": {
			"types": "./out/span-rescore.d.ts",
			"node": "./lib/span-rescore.ts",
			"default": "./out/span-rescore.js"
		},
		"./backend-capabilities": {
			"types": "./out/backend-capabilities.d.ts",
			"node": "./lib/backend-capabilities.ts",
			"default": "./out/backend-capabilities.js"
		},
		"./decorate-node": {
			"types": "./out/decorate-node.d.ts",
			"node": "./lib/decorate-node.ts",
			"default": "./out/decorate-node.js"
		},
		"./plausibility": {
			"types": "./out/plausibility.d.ts",
			"node": "./lib/plausibility.ts",
			"default": "./out/plausibility.js"
		},
		"./remote-resolver": {
			"types": "./out/remote-resolver.d.ts",
			"node": "./lib/remote-resolver.ts",
			"default": "./out/remote-resolver.js"
		},
		"./rerank": {
			"types": "./out/rerank.d.ts",
			"node": "./lib/rerank.ts",
			"default": "./out/rerank.js"
		},
		"./toponym-prior": {
			"types": "./out/toponym-prior.d.ts",
			"node": "./lib/toponym-prior.ts",
			"default": "./out/toponym-prior.js"
		},
		"./admin": {
			"types": "./out/admin/index.d.ts",
			"node": "./lib/admin/index.ts",
			"default": "./out/admin/index.js"
		},
		"./postcode": {
			"types": "./out/postcode/index.d.ts",
			"node": "./lib/postcode/index.ts",
			"default": "./out/postcode/index.js"
		},
		"./street": {
			"types": "./out/street/index.d.ts",
			"node": "./lib/street/index.ts",
			"default": "./out/street/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/evidence": "workspace:*",
		"@mailwoman/spatial": "workspace:*"
	},
	"devDependencies": {
		"path-ts": "^2.3.0"
	}
}
