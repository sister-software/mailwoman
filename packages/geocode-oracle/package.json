{
	"name": "@mailwoman/geocode-oracle",
	"version": "8.7.0",
	"private": true,
	"description": "Third-party reference geocoders (Google, US Census) as a VERIFICATION ORACLE for gauntlet-case authoring — private, never a runtime dependency of the parser",
	"keywords": [
		"census",
		"geocoding",
		"google",
		"oracle",
		"tiger"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/geocode-oracle"
	},
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./sdk": {
			"types": "./out/sdk/index.d.ts",
			"node": "./lib/sdk/index.ts",
			"default": "./out/sdk/index.js"
		},
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./env": {
			"types": "./out/env.d.ts",
			"node": "./lib/env.ts",
			"default": "./out/env.js"
		},
		"./sdk/census-client": {
			"types": "./out/sdk/census/client.d.ts",
			"node": "./lib/sdk/census/client.ts",
			"default": "./out/sdk/census/client.js"
		},
		"./sdk/census-parser": {
			"types": "./out/sdk/census/parser.d.ts",
			"node": "./lib/sdk/census/parser.ts",
			"default": "./out/sdk/census/parser.js"
		},
		"./sdk/census-types": {
			"types": "./out/sdk/census/types.d.ts",
			"node": "./lib/sdk/census/types.ts",
			"default": "./out/sdk/census/types.js"
		},
		"./sdk/map-link": {
			"types": "./out/sdk/map-link.d.ts",
			"node": "./lib/sdk/map-link.ts",
			"default": "./out/sdk/map-link.js"
		},
		"./sdk/google-client": {
			"types": "./out/sdk/google/client.d.ts",
			"node": "./lib/sdk/google/client.ts",
			"default": "./out/sdk/google/client.js"
		},
		"./sdk/google-parser": {
			"types": "./out/sdk/google/parser.d.ts",
			"node": "./lib/sdk/google/parser.ts",
			"default": "./out/sdk/google/parser.js"
		},
		"./sdk/google-types": {
			"types": "./out/sdk/google/types.d.ts",
			"node": "./lib/sdk/google/types.ts",
			"default": "./out/sdk/google/types.js"
		}
	},
	"scripts": {
		"test": "vitest run"
	},
	"dependencies": {
		"@mailwoman/address-id": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/record": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/tiger": "workspace:*",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"path-ts": "^2.3.0"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
