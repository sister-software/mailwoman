{
	"name": "@mailwoman/release-kit",
	"version": "9.2.0",
	"private": true,
	"description": "Release operations as a registry — preflight, prepare, pack, verify, stage, publish, weights materialization — consumed through adapters (the private mwops CLI, the release MCP), never run as files.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/release-kit"
	},
	"files": [
		"lib",
		"out",
		"README.md"
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./env": {
			"types": "./out/env/index.d.ts",
			"node": "./lib/env/index.ts",
			"default": "./out/env/index.js"
		},
		"./registry": {
			"types": "./out/registry.d.ts",
			"node": "./lib/registry.ts",
			"default": "./out/registry.js"
		},
		"./pack/pack-workspace": {
			"types": "./out/pack/pack-workspace.d.ts",
			"node": "./lib/pack/pack-workspace.ts",
			"default": "./out/pack/pack-workspace.js"
		},
		"./release/stage": {
			"types": "./out/release/stage.d.ts",
			"node": "./lib/release/stage.ts",
			"default": "./out/release/stage.js"
		},
		"./release/smoke-get-started": {
			"types": "./out/release/smoke-get-started.d.ts",
			"node": "./lib/release/smoke-get-started.ts",
			"default": "./out/release/smoke-get-started.js"
		},
		"./release/workspace-closure": {
			"types": "./out/release/workspace-closure.d.ts",
			"node": "./lib/release/workspace-closure.ts",
			"default": "./out/release/workspace-closure.js"
		},
		"./pack/verify-tarball": {
			"types": "./out/pack/verify-tarball.d.ts",
			"node": "./lib/pack/verify-tarball.ts",
			"default": "./out/pack/verify-tarball.js"
		},
		"./weights/fetch-hf-weights": {
			"types": "./out/weights/fetch-hf-weights.d.ts",
			"node": "./lib/weights/fetch-hf-weights.ts",
			"default": "./out/weights/fetch-hf-weights.js"
		},
		"./weights/derived-weights-key": {
			"types": "./out/weights/derived-weights-key.d.ts",
			"node": "./lib/weights/derived-weights-key.ts",
			"default": "./out/weights/derived-weights-key.js"
		},
		"./pack/publish-exports": {
			"types": "./out/pack/publish-exports.d.ts",
			"node": "./lib/pack/publish-exports.ts",
			"default": "./out/pack/publish-exports.js"
		},
		"./release/config-version": {
			"types": "./out/release/config-version.d.ts",
			"node": "./lib/release/config-version.ts",
			"default": "./out/release/config-version.js"
		},
		"./weights/weights-recipe": {
			"types": "./out/weights/weights-recipe.d.ts",
			"node": "./lib/weights/weights-recipe.ts",
			"default": "./out/weights/weights-recipe.js"
		}
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"mailwoman": "workspace:*",
		"path-ts": "^2.3.0",
		"semver": "^7.8.5",
		"spliterator": "^6.4.1",
		"zod": "^4.5.4",
		"zx": "^8.8.5"
	},
	"devDependencies": {
		"@types/semver": "^7.8.0"
	}
}
