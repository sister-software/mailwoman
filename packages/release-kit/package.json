{
	"name": "@mailwoman/release-kit",
	"version": "9.2.0",
	"private": true,
	"description": "Release operations as a registry — preflight, prepare, pack, verify, stage, publish, weights materialization — consumed through adapters (the private mwops CLI, the release MCP), never run as files.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/release-kit"
	},
	"files": [
		"lib",
		"out",
		"README.md",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/corpus": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"mailwoman": "workspace:*",
		"path-ts": "^2.5.0",
		"semver": "^7.8.5",
		"spliterator": "^8.1.0",
		"zod": "^4.6.5",
		"zx": "^8.8.5"
	},
	"devDependencies": {
		"@types/semver": "^7.8.0"
	}
}
