{
	"name": "@mailwoman/neural-weights-en-us",
	"version": "9.2.0",
	"description": "Mailwoman neural-classifier weights for locale 'en-us'. Data-only package — loaded by @mailwoman/neural at runtime.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/neural-weights-en-us"
	},
	"files": [
		"model.onnx",
		"tokenizer.model",
		"model-card.json",
		"calibration.json",
		"calibration-per-locale.json",
		"postcode-us.bin",
		"pair-index-us.bin",
		"fst-en-us.bin",
		"fst-street-morphology.bin",
		"anchor-lexicon-v1.json",
		"locality-surface-lexicon-v7.json",
		"street-type-lexicon-v3.json",
		"country-surface-lexicon-v1.json",
		"README.md",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!scripts/**",
		"!test/**"
	],
	"exports": {
		"./*": "./*"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*"
	}
}
