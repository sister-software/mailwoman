# Symlinks created by `scripts/link-dev-weights.sh` for local testing.
# At publish time these get replaced with real files copied from /mnt/playpen/
# (per the `files` array in package.json).
/model.onnx
/tokenizer.model

# Soft-feed artifacts materialized at publish time by scripts/copy-weights.ts (#718 D1):
# the compact PCB1 postcode-anchor binary + the gazetteer-anchor lexicon. Built from the
# WOF postcode shard + data/gazetteer/, not committed (mirrors model.onnx/tokenizer.model).
/postcode-*.bin
/anchor-lexicon-v1.json

# The #1104 country soft-feed channel's lexicon artifact (same treatment as anchor-lexicon-v1.json
# above — copied from data/gazetteer/ at dev-link/publish time, not committed here).
/country-surface-lexicon-v1.json

# Per-locale FST gazetteer (FST-distribution arc, 2026-07-25) — dev symlink from
# $MAILWOMAN_DATA_ROOT/wof/fst-per-locale/, real binary staged at publish time.
/fst-*.bin

# Evidence-bundle lexicons (Option-A, 6.7.0-bundle): materialized at dev-link/publish time from
# data/gazetteer/ + the data root (same treatment as anchor-lexicon-v1.json above). Version-wildcarded
# so a lexicon bump never re-strays.
/street-type-lexicon-*.json
/locality-surface-lexicon-*.json

# The placetype-pair index (hierarchy campaign R5) — built from the WOF admin DB by
# `scripts/link-dev-weights.ts` for local dev, fetched from the HF bucket at publish time. Same
# not-committed treatment as postcode-*.bin: a derived artifact, never a source of truth.
/pair-index-*.bin
