{
	// Non-emitting companion to ./tsconfig.json — see ../../tsconfig.test-base.json for why it exists.
	"extends": ["./tsconfig.json", "../../tsconfig.test-base.json"],
	"include": ["./**/*.test.ts", "./test/**/*"],
	"exclude": ["./out/**/*"],
	// `../core`, `../flood`, `../bduk` and `../resolver-wof-sqlite` are referenced by the test project only: the
	// full-data test reads the host's `flood.db`, BDUK's extracted London files and `nsul.db`, and the library
	// declares no dependency on any of them.
	"references": [
		{ "path": "./tsconfig.json" },
		{ "path": "../core" },
		{ "path": "../flood" },
		{ "path": "../bduk" },
		{ "path": "../resolver-wof-sqlite" }
	]
}
