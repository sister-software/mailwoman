{
	// Non-emitting companion to ./tsconfig.json — see ../../tsconfig.test-base.json for why it exists.
	"extends": ["./tsconfig.json", "../../tsconfig.test-base.json"],
	"include": ["./**/*.test.ts", "./test/**/*"],
	"exclude": ["./out/**/*"],
	// `../core` and `../flood` are referenced by the test project only: the full-data test reads the host's
	// `flood.db`, and the library declares no dependency on either.
	"references": [{ "path": "./tsconfig.json" }, { "path": "../core" }, { "path": "../flood" }]
}
