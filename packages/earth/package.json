{
	"name": "@mailwoman/earth",
	"version": "1.0.0",
	"private": true,
	"description": "Earth — the mailwoman geocoder map at earth.mailwoman.post: a React + Vite installable PWA on Cloudflare Workers Static Assets.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"type": "module",
	"imports": {
		"#e2e": "./test/e2e/index.ts",
		"#e2e/*": "./test/e2e/*",
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"default": "./lib/*.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 7771 --strictPort",
		"test:browser": "playwright test",
		"deploy:dry-run": "wrangler deploy --dry-run"
	},
	"dependencies": {
		"3d-tiles-renderer": "0.5.4",
		"@deck.gl/core": "^9.4.1",
		"@deck.gl/extensions": "^9.4.1",
		"@deck.gl/geo-layers": "^9.4.1",
		"@deck.gl/layers": "^9.4.1",
		"@deck.gl/mapbox": "^9.4.1",
		"@deck.gl/mesh-layers": "^9.4.1",
		"@loaders.gl/3d-tiles": "^4.5.4",
		"@loaders.gl/core": "^4.5.4",
		"@luma.gl/core": "^9.4.2",
		"@luma.gl/engine": "^9.4.2",
		"@luma.gl/shadertools": "^9.4.2",
		"@mailwoman/api": "workspace:*",
		"@mailwoman/cartographer": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/geocoder-service": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/react": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*",
		"@mailwoman/service-worker-cache": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/structures": "workspace:*",
		"@mailwoman/undersea": "workspace:*",
		"@mailwoman/universe": "workspace:*",
		"@math.gl/core": "^4.1.0",
		"@math.gl/geospatial": "^4.1.0",
		"@sister.software/h3": "^1.1.0",
		"mailwoman": "workspace:*",
		"maplibre-gl": "^6.16.0",
		"onnxruntime-web": "1.31.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-map-gl": "^8.1.3",
		"spliterator": "^10.1.1",
		"three": "0.187.0",
		"workbox-cacheable-response": "^7.4.1",
		"workbox-expiration": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "0.187.0",
		"@vitejs/plugin-react": "^6.2.1",
		"vite": "^8.3.6",
		"vite-plugin-pwa": "^2.0.0",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.157.0"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
