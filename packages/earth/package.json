{
	"name": "@mailwoman/earth",
	"version": "1.0.0",
	"private": true,
	"description": "Earth — the mailwoman geocoder map at earth.mailwoman.ai: a React + Vite installable PWA on Cloudflare Workers Static Assets.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"type": "module",
	"imports": {
		"#e2e": "./test/e2e/index.ts",
		"#e2e/*": "./test/e2e/*",
		"#*": {
			"types": "./out/*.d.ts",
			"default": "./lib/*.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 7771 --strictPort",
		"test:browser": "playwright test",
		"deploy:dry-run": "wrangler deploy --dry-run"
	},
	"dependencies": {
		"@deck.gl/core": "^9.4.0",
		"@deck.gl/extensions": "^9.4.0",
		"@deck.gl/geo-layers": "^9.4.0",
		"@deck.gl/layers": "^9.4.0",
		"@deck.gl/mapbox": "^9.4.0",
		"@deck.gl/mesh-layers": "^9.4.0",
		"@loaders.gl/3d-tiles": "^4.5.4",
		"@loaders.gl/core": "^4.5.4",
		"@luma.gl/core": "^9.4.2",
		"@luma.gl/engine": "^9.4.2",
		"@luma.gl/shadertools": "^9.4.2",
		"@mailwoman/api": "workspace:*",
		"@mailwoman/cartographer": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/react": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/structures": "workspace:*",
		"@mailwoman/universe": "workspace:*",
		"@math.gl/core": "^4.1.0",
		"@math.gl/geospatial": "^4.1.0",
		"mailwoman": "workspace:*",
		"maplibre-gl": "^6.14.0",
		"onnxruntime-web": "1.30.0",
		"pmtiles": "^4.5.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-map-gl": "^8.1.3",
		"spliterator": "^10.1.1",
		"workbox-precaching": "^7.4.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^2.0.0",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.151.0"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
