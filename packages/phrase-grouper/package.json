{
	"name": "@mailwoman/phrase-grouper",
	"version": "9.4.0",
	"description": "Stage 2.7 of the runtime pipeline — propose coherent input units (boundary discovery) with a structural kind hypothesis + confidence. Rule-based v1 (port of v1 section/sub-section logic); learned 1-2M-param span proposer reserved for v0.5.1.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/phrase-grouper"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#index": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./group": {
			"types": "./out/group.d.ts",
			"node": "./lib/group.ts",
			"default": "./out/group.js"
		},
		"./rules": {
			"types": "./out/rules.d.ts",
			"node": "./lib/rules.ts",
			"default": "./out/rules.js"
		},
		"./types": {
			"types": "./out/types.d.ts",
			"node": "./lib/types.ts",
			"default": "./out/types.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/query-shape": "workspace:*"
	},
	"devDependencies": {
		"@mailwoman/normalize": "workspace:*"
	}
}
