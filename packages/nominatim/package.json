{
	"name": "@mailwoman/nominatim",
	"version": "10.1.0",
	"description": "Nominatim drop-in — a Nominatim-compatible HTTP geocoding API (search / reverse / lookup / status) over the Mailwoman engine. Run it with `npx @mailwoman/nominatim serve`.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/nominatim"
	},
	"bin": "./out/cli/main.js",
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"cli/**/*.ts",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#cli/*": {
			"types": "./out/cli/*.d.ts",
			"node": "./cli/*.ts",
			"default": "./out/cli/*.js"
		},
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./cli/*": {
			"types": "./out/cli/*.d.ts",
			"node": "./cli/*.ts",
			"default": "./out/cli/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@mailwoman/annotations": "workspace:*",
		"@mailwoman/api-kit": "workspace:*",
		"@mailwoman/ban": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/neural-weights-en-us": "workspace:*",
		"@mailwoman/nuts-lookup": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@mailwoman/timezone-lookup": "workspace:*",
		"@mailwoman/un-locode-lookup": "workspace:*",
		"hono": "^4.13.8",
		"mailwoman": "workspace:*",
		"path-ts": "^2.5.0",
		"spliterator": "^8.1.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@mailwoman/core": "workspace:*"
	}
}
