{
	// The command-line root. It compiles to `../out/cli` beside the library's `../out`, and it references the
	// library project because the command line imports the library and never the reverse.
	"extends": "@sister.software/tsconfig/node",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "../out/cli",
		"emitDeclarationOnly": false,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["./**/*"],
	"exclude": ["./**/*.test.ts", "./**/*.test.tsx"],
	"references": [
		{ "path": ".." },
		// ---
		{ "path": "../../annotations" },
		{ "path": "../../api-kit" },
		{ "path": "../../codex" },
		{ "path": "../../core" },
		{ "path": "../../mailwoman" },
		{ "path": "../../mailwoman/cli" },
		{ "path": "../../nuts-lookup" },
		{ "path": "../../resolver" },
		{ "path": "../../spatial" },
		{ "path": "../../timezone-lookup" },
		{ "path": "../../un-locode-lookup" }
	]
}
