{
	"name": "@mailwoman/registry",
	"version": "11.4.0",
	"description": "A generated, typed registry of standardized identifiers and their relationships: ISO 3166-1 country codes, IATA airport codes, ISO 639 language subtags, ISO 15924 scripts and BCP 47 tags in this release, compiled from pinned open sources into RGY1 lookup artifacts with branded types, a synchronous TypeScript reader, a Rust lookup core and a WebAssembly batch adapter.",
	"keywords": [
		"airport-codes",
		"bcp47",
		"country-codes",
		"iata",
		"iso-3166",
		"registry"
	],
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/registry"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"lib/artifacts/**/*.fixture.json",
		"out/artifacts/**/*.fixture.json",
		"sdk/**/*.ts",
		"tools/**/*.ts",
		"data/manifests/*.json",
		"data/normalized/*.json",
		"definitions/*.json",
		"wasm/*.wasm",
		"docs/*.md",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"sideEffects": [
		"./sdk/**/*.run.ts",
		"./sdk/sources.ts",
		"./out/sdk/sources.js",
		"./tools/**/*.run.ts",
		"./out/sdk/**/*.run.js",
		"./out/tools/**/*.run.js"
	],
	"imports": {
		"#sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./wasm/registry.wasm": "./wasm/registry.wasm",
		"./wasm/registry-simd.wasm": "./wasm/registry-simd.wasm",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"path-ts": "^2.5.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"esbuild": "0.28.2"
	}
}
