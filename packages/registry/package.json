{
	"name": "@mailwoman/registry",
	"version": "9.2.0",
	"description": "The geocode-first record-matching application: resolve messy contact/organization records into canonical, geocoded entities (block → score → cluster) and export them as GeoJSON for spatial analysis. The clinic-funding use case mailwoman was built for.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/registry"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#index": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"#*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./resolve": {
			"node": "./lib/resolve.ts",
			"default": "./out/resolve.js",
			"types": "./out/resolve.d.ts"
		},
		"./geojson": {
			"node": "./lib/geojson.ts",
			"default": "./out/geojson.js",
			"types": "./out/geojson.d.ts"
		},
		"./ingest": {
			"node": "./lib/ingest.ts",
			"default": "./out/ingest.js",
			"types": "./out/ingest.d.ts"
		},
		"./tools": {
			"node": "./lib/tools/index.ts",
			"default": "./out/tools/index.js",
			"types": "./out/tools/index.d.ts"
		},
		"./address-key": {
			"node": "./lib/address-key.ts",
			"default": "./out/address-key.js",
			"types": "./out/address-key.d.ts"
		},
		"./types": {
			"node": "./lib/types.ts",
			"default": "./out/types.js",
			"types": "./out/types.d.ts"
		},
		"./geocode-handler": {
			"node": "./lib/geocode-handler.ts",
			"default": "./out/geocode-handler.js",
			"types": "./out/geocode-handler.d.ts"
		},
		"./learned-scorer": {
			"node": "./lib/learned-scorer.ts",
			"default": "./out/learned-scorer.js",
			"types": "./out/learned-scorer.d.ts"
		},
		"./map-html": {
			"node": "./lib/map-html.ts",
			"default": "./out/map-html.js",
			"types": "./out/map-html.d.ts"
		},
		"./reconcile": {
			"node": "./lib/reconcile.ts",
			"default": "./out/reconcile.js",
			"types": "./out/reconcile.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/address-id": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/match": "workspace:*",
		"@mailwoman/record": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@protomaps/basemaps": "^5.7.2",
		"h3-js": "^4.5.0",
		"spliterator": "^6.4.1"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"path-ts": "^2.3.0",
		"playwright": "^1.62.1"
	}
}
