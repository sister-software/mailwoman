{
	"name": "@mailwoman/filer",
	"version": "10.1.0",
	"description": "Identity-crosswalk infrastructure for FCC broadband filers — builds and reads filer.db, linking FRN/Form 499/BDC provider_id/holding & management company identifiers with provenance and temporal (asOf) scoping (Phase 3a)",
	"keywords": [
		"broadband",
		"crosswalk",
		"entity-resolution",
		"fcc",
		"identity"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/filer"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"sdk/**/*.ts",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/match": "workspace:*",
		"@mailwoman/record": "workspace:*",
		"@mailwoman/registry": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"kysely": "^0.29.6",
		"path-ts": "^2.5.0",
		"read-excel-file": "^9.3.10",
		"spliterator": "^9.0.0",
		"type-fest": "^5.10.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"dom-serializer": "^3.1.1",
		"domhandler": "^6.0.1",
		"domutils": "^4.0.2",
		"htmlparser2": "^12.0.0",
		"write-excel-file": "^4.1.1"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
