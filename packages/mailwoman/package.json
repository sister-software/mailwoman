{
	"name": "mailwoman",
	"version": "10.1.0",
	"description": "A calibrated, retrieval-augmented postal-address parser — CLI + library.",
	"keywords": [
		"address",
		"parser",
		"pelias",
		"postal",
		"usps"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		},
		{
			"name": "Pelias Contributors"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/mailwoman"
	},
	"man": "./man/mailwoman.1",
	"bin": {
		"mailwoman": "./out/cli/main.js",
		"mw": "./out/cli/main.js"
	},
	"files": [
		"!out/test/**/*",
		"out/**/*.js",
		"out/**/*.mjs",
		"out/**/*.js.map",
		"out/**/*.mjs.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"out/**/*.json",
		"tools/eval-harness/specs/*.json",
		"tools/eval-harness/baselines.json",
		"tools/eval-harness/gauntlet/cases/*/*.jsonl",
		"tools/eval-harness/conformance/*.jsonl",
		"tools/eval-harness/semantic-utility/*.json",
		"tools/eval-harness/absence-observation/*.json",
		"tools/eval-harness/phase-2-decision/*.json",
		"tools/eval-harness/invariance/*.jsonl",
		"skills",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"cli/**/*.ts",
		"cli/**/*.tsx",
		"tools/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"man/mailwoman.1"
	],
	"type": "module",
	"imports": {
		"#cli/*": {
			"types": "./out/cli/*.d.ts",
			"node": "./cli/*.ts",
			"default": "./out/cli/*.js"
		},
		"#tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"#env": {
			"types": "./out/env.d.ts",
			"node": "./lib/env.ts",
			"default": "./out/env.js"
		},
		"#geocode": {
			"types": "./out/geocode.d.ts",
			"node": "./lib/geocode.ts",
			"default": "./out/geocode.js"
		},
		"#poi": {
			"types": "./out/poi.d.ts",
			"node": "./lib/poi.ts",
			"default": "./out/poi.js"
		},
		"#default": {
			"types": "./out/default.d.ts",
			"node": "./lib/default.ts",
			"default": "./out/default.js"
		},
		"#data": {
			"types": "./out/data.d.ts",
			"node": "./lib/data.ts",
			"default": "./out/data.js"
		},
		"#street": {
			"types": "./out/street.d.ts",
			"node": "./lib/street.ts",
			"default": "./out/street.js"
		},
		"#coverage": {
			"types": "./out/tools/coverage.d.ts",
			"node": "./tools/coverage.ts",
			"default": "./out/tools/coverage.js"
		},
		"#doctor": {
			"types": "./out/cli/doctor.d.ts",
			"node": "./cli/doctor.ts",
			"default": "./out/cli/doctor.js"
		},
		"#gazetteer/*": {
			"types": "./out/tools/gazetteer-pipeline/*.d.ts",
			"node": "./tools/gazetteer-pipeline/*.ts",
			"default": "./out/tools/gazetteer-pipeline/*.js"
		},
		"#cli-kit": {
			"types": "./out/cli/kit.d.ts",
			"node": "./cli/kit.ts",
			"default": "./out/cli/kit.js"
		},
		"#gazetteer-pipeline": {
			"types": "./out/tools/gazetteer-pipeline.d.ts",
			"node": "./tools/gazetteer-pipeline.ts",
			"default": "./out/tools/gazetteer-pipeline.js"
		},
		"#index": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"#cli-kit/weights-guard": {
			"types": "./out/cli/kit/weights-guard.d.ts",
			"node": "./out/cli/kit/weights-guard.js",
			"default": "./out/cli/kit/weights-guard.js"
		},
		"#autocomplete-core": {
			"types": "./out/autocomplete-core.d.ts",
			"node": "./lib/autocomplete-core.ts",
			"default": "./out/autocomplete-core.js"
		},
		"#commands/registry/run": {
			"types": "./out/cli/commands/registry/run.d.ts",
			"node": "./out/cli/commands/registry/run.js",
			"default": "./out/cli/commands/registry/run.js"
		},
		"#debug-view/command": {
			"types": "./out/cli/debug-view/command.d.ts",
			"node": "./out/cli/debug-view/command.js",
			"default": "./out/cli/debug-view/command.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./debug-view/DebugFrame": {
			"types": "./out/cli/debug-view/DebugFrame.d.ts",
			"node": "./cli/debug-view/DebugFrame.tsx",
			"default": "./out/cli/debug-view/DebugFrame.js"
		},
		"./debug-view/command": {
			"types": "./out/cli/debug-view/command.d.ts",
			"node": "./cli/debug-view/command.tsx",
			"default": "./out/cli/debug-view/command.js"
		},
		"./cli-kit/weights-guard": {
			"types": "./out/cli/kit/weights-guard.d.ts",
			"node": "./out/cli/kit/weights-guard.js",
			"default": "./out/cli/kit/weights-guard.js"
		},
		"./commands/parse": {
			"types": "./out/cli/commands/parse.d.ts",
			"node": "./cli/commands/parse.tsx",
			"default": "./out/cli/commands/parse.js"
		},
		"./commands/corpus/run": {
			"types": "./out/cli/commands/corpus/run.d.ts",
			"node": "./cli/commands/corpus/run.tsx",
			"default": "./out/cli/commands/corpus/run.js"
		},
		"./commands/registry/run": {
			"types": "./out/cli/commands/registry/run.d.ts",
			"node": "./cli/commands/registry/run.tsx",
			"default": "./out/cli/commands/registry/run.js"
		},
		"./cli/*": {
			"types": "./out/cli/*.d.ts",
			"node": "./cli/*.ts",
			"default": "./out/cli/*.js"
		},
		"./tools/*": {
			"types": "./out/tools/*.d.ts",
			"node": "./tools/*.ts",
			"default": "./out/tools/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1147.0",
		"@aws-sdk/lib-storage": "^3.1147.0",
		"@inkjs/ui": "^2.0.0",
		"@isaacs/cliui": "^9.0.0",
		"@mailwoman/activity-lexicon": "workspace:*",
		"@mailwoman/annotations": "workspace:*",
		"@mailwoman/api": "workspace:*",
		"@mailwoman/api-kit": "workspace:*",
		"@mailwoman/ban": "workspace:*",
		"@mailwoman/bdc": "workspace:*",
		"@mailwoman/coastal": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/corpus": "workspace:*",
		"@mailwoman/evidence": "workspace:*",
		"@mailwoman/filer": "workspace:*",
		"@mailwoman/flood": "workspace:*",
		"@mailwoman/geographic-model": "workspace:*",
		"@mailwoman/kind-classifier": "workspace:*",
		"@mailwoman/locale-hint": "workspace:*",
		"@mailwoman/map-tui": "workspace:*",
		"@mailwoman/match": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/neural-weights-en-us": "workspace:*",
		"@mailwoman/normalize": "workspace:*",
		"@mailwoman/phrase-grouper": "workspace:*",
		"@mailwoman/poi-taxonomy": "workspace:*",
		"@mailwoman/query-shape": "workspace:*",
		"@mailwoman/registry": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/soil": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@mailwoman/variant-aliases": "workspace:*",
		"@mailwoman/zoning": "workspace:*",
		"chalk": "^6.0.1",
		"d3-scale-chromatic": "^3.1.0",
		"h3-js": "^4.5.0",
		"ink": "^8.0.0",
		"kysely": "^0.29.6",
		"onnxruntime-node": "^1.30.0",
		"path-ts": "^2.5.0",
		"react": "^19.3.0",
		"spliterator": "^8.1.0",
		"zod": "^4.6.5",
		"zx": "^8.8.5"
	},
	"devDependencies": {
		"@mailwoman/osm": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*"
	},
	"peerDependencies": {
		"@duckdb/node-api": "1.5.6-r.1"
	},
	"peerDependenciesMeta": {
		"@duckdb/node-api": {
			"optional": true
		},
		"@inkjs/ui": {
			"optional": true
		},
		"ink": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"@mailwoman/tiger": "workspace:*"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
