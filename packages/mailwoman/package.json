{
	"name": "mailwoman",
	"version": "9.1.0",
	"description": "A calibrated, retrieval-augmented postal-address parser — CLI + library.",
	"keywords": [
		"address",
		"parser",
		"pelias",
		"postal",
		"usps"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		},
		{
			"name": "Pelias Contributors"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/mailwoman"
	},
	"man": "./man/mailwoman.1",
	"bin": {
		"mailwoman": "./out/cli.js",
		"mw": "./out/cli.js"
	},
	"files": [
		"!out/test/**/*",
		"out/**/*.js",
		"out/**/*.mjs",
		"out/**/*.js.map",
		"out/**/*.mjs.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"out/**/*.json",
		"eval-harness/gates/*.json",
		"eval-harness/baselines.json",
		"eval-harness/gauntlet/cases/*/*.jsonl",
		"skills",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"man/mailwoman.1"
	],
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./dev-tools/*": {
			"node": "./dev-tools/*.ts",
			"default": "./out/dev-tools/*.js",
			"types": "./out/dev-tools/*.d.ts"
		},
		"./eval-harness/*": {
			"node": "./eval-harness/*.ts",
			"default": "./out/eval-harness/*.js",
			"types": "./out/eval-harness/*.d.ts"
		},
		"./geocode-core": {
			"node": "./geocode-core.ts",
			"default": "./out/geocode-core.js",
			"types": "./out/geocode-core.d.ts"
		},
		"./geocode-session": {
			"node": "./geocode-session.ts",
			"default": "./out/geocode-session.js",
			"types": "./out/geocode-session.d.ts"
		},
		"./debug-view/*": {
			"node": "./debug-view/*.ts",
			"default": "./out/debug-view/*.js",
			"types": "./out/debug-view/*.d.ts"
		},
		"./geocode-stream": {
			"node": "./geocode-stream.ts",
			"default": "./out/geocode-stream.js",
			"types": "./out/geocode-stream.d.ts"
		},
		"./resolver-backend": {
			"node": "./resolver-backend.ts",
			"default": "./out/resolver-backend.js",
			"types": "./out/resolver-backend.d.ts"
		},
		"./gazetteer-pipeline": {
			"node": "./gazetteer-pipeline/index.ts",
			"default": "./out/gazetteer-pipeline/index.js",
			"types": "./out/gazetteer-pipeline/index.d.ts"
		},
		"./gazetteer-pipeline/admin": {
			"node": "./gazetteer-pipeline/admin/index.ts",
			"default": "./out/gazetteer-pipeline/admin/index.js",
			"types": "./out/gazetteer-pipeline/admin/index.d.ts"
		},
		"./gazetteer-pipeline/*": {
			"node": "./gazetteer-pipeline/*.ts",
			"default": "./out/gazetteer-pipeline/*.js",
			"types": "./out/gazetteer-pipeline/*.d.ts"
		},
		"./cli-kit": {
			"node": "./cli-kit/index.ts",
			"default": "./out/cli-kit/index.js",
			"types": "./out/cli-kit/index.d.ts"
		},
		"./cli-kit/metadata": {
			"node": "./cli-kit/metadata.ts",
			"default": "./out/cli-kit/metadata.js",
			"types": "./out/cli-kit/metadata.d.ts"
		},
		"./cli-kit/dropin": {
			"node": "./cli-kit/dropin.ts",
			"default": "./out/cli-kit/dropin.js",
			"types": "./out/cli-kit/dropin.d.ts"
		},
		"./cli-kit/weights-guard": {
			"node": "./out/cli-kit/weights-guard.js",
			"default": "./out/cli-kit/weights-guard.js",
			"types": "./out/cli-kit/weights-guard.d.ts"
		},
		"./test-kit": {
			"node": "./test-kit/index.ts",
			"default": "./out/test-kit/index.js",
			"types": "./out/test-kit/index.d.ts"
		},
		"./poi-overpass": {
			"node": "./poi-overpass.ts",
			"default": "./out/poi-overpass.js",
			"types": "./out/poi-overpass.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@inkjs/ui": "^2.0.0",
		"@isaacs/cliui": "^9.0.0",
		"@mailwoman/annotations": "workspace:*",
		"@mailwoman/api": "workspace:*",
		"@mailwoman/api-kit": "workspace:*",
		"@mailwoman/ban": "workspace:*",
		"@mailwoman/bdc": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/corpus": "workspace:*",
		"@mailwoman/filer": "workspace:*",
		"@mailwoman/formatter": "workspace:*",
		"@mailwoman/kind-classifier": "workspace:*",
		"@mailwoman/locale-gate": "workspace:*",
		"@mailwoman/map-tui": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/normalize": "workspace:*",
		"@mailwoman/phrase-grouper": "workspace:*",
		"@mailwoman/poi-taxonomy": "workspace:*",
		"@mailwoman/query-shape": "workspace:*",
		"@mailwoman/registry": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/variant-aliases": "workspace:*",
		"chalk": "^6.0.0",
		"change-case": "^5.4.4",
		"d3-scale-chromatic": "^3.1.0",
		"fast-glob": "^3.3.3",
		"h3-js": "^4.5.0",
		"ink": "^7.1.1",
		"kysely": "^0.29.5",
		"onnxruntime-node": "^1.26.0",
		"path-ts": "^2.1.0",
		"pluralize": "^8.0.0",
		"react": "^19.2.8",
		"regenerate": "^1.4.2",
		"spliterator": "^6.1.0",
		"yauzl-promise": "^4.0.0",
		"zod": "^4.4.3",
		"zx": "^8.8.5"
	},
	"devDependencies": {
		"@mailwoman/osm": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*",
		"@types/yauzl-promise": "^4.0.1"
	},
	"peerDependencies": {
		"@duckdb/node-api": "1.5.3-r.3",
		"@mailwoman/resolver-wof-sqlite": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@duckdb/node-api": {
			"optional": true
		},
		"@inkjs/ui": {
			"optional": true
		},
		"@mailwoman/resolver-wof-sqlite": {
			"optional": true
		},
		"ink": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"@mailwoman/tiger": "workspace:*"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
