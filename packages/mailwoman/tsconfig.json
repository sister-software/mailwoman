{
	"extends": "@sister.software/tsconfig/node",
	"compilerOptions": {
		"rootDir": "./lib",
		// The Ink commands are TSX — this package runs on Node AND renders JSX, so it declares
		// the transform itself rather than inheriting one every non-rendering package would also get.
		"jsx": "react-jsx",
		"outDir": "./out",
		"emitDeclarationOnly": false,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["./lib/**/*"],
	"exclude": ["./out/**/*", "./**/*.test.ts", "./**/*.test.tsx", "./test/**/*"],
	"references": [
		{ "path": "../sqlite" },
		{ "path": "../api" },
		{ "path": "../api-kit" },
		{ "path": "../bdc" },
		{ "path": "../coastal" },
		{ "path": "../core" },
		{ "path": "../filer" },
		{ "path": "../flood" },
		{ "path": "../geographic-model" },
		{ "path": "../resolver" },
		{ "path": "../corpus" },
		{ "path": "../kind-classifier" },
		{ "path": "../locale-hint" },
		{ "path": "../match" },
		{ "path": "../neural" },
		{ "path": "../normalize" },
		{ "path": "../phrase-grouper" },
		{ "path": "../poi-taxonomy" },
		{ "path": "../query-shape" },
		{ "path": "../registry" },
		{ "path": "../resolver-wof-sqlite" },
		{ "path": "../resolver-wof-wasm" },
		{ "path": "../ban" },
		{ "path": "../soil" },
		{ "path": "../zoning" },
		{ "path": "../spatial" },
		{ "path": "../osm" },
		{ "path": "../map-tui" }
	]
}
