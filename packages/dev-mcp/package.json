{
	"name": "@mailwoman/dev-mcp",
	"version": "9.1.0",
	"private": true,
	"description": "Maintainer-only MCP server — a warm geocoder and well-powered measurement, so an agent reaches for the board instead of a probe script.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/dev-mcp"
	},
	"bin": {
		"mwdev-mcp": "./lib/cli.ts"
	},
	"type": "module",
	"imports": {
		"#test/stub-registry": "./test/stub-registry.ts",
		"#*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./tools": {
			"node": "./lib/tools/index.ts",
			"default": "./out/tools/index.js",
			"types": "./out/tools/index.d.ts"
		},
		"./hooks/*": {
			"node": "./lib/hooks/*.ts",
			"default": "./out/hooks/*.js",
			"types": "./out/hooks/*.d.ts"
		},
		"./*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/geocode-oracle": "workspace:*",
		"@mailwoman/libpostal": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/normalize": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"mailwoman": "workspace:*",
		"path-ts": "^2.3.0",
		"spliterator": "^6.4.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@vvago/vale": "^3.20.0"
	}
}
