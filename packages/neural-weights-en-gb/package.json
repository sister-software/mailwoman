{
	"name": "@mailwoman/neural-weights-en-gb",
	"version": "9.2.0",
	"description": "Mailwoman neural-classifier weights for locale 'en-gb'. Data-only overlay — shares the base model.onnx + tokenizer.model from @mailwoman/neural-weights-en-us (they are byte-identical); ships only the gb-specific data siblings — pair-index-gb.bin and postcode-gb.bin, the latter feeding a trained GB anchor slot (see model-card.json's gb_artifacts). Loaded by @mailwoman/neural at runtime.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/neural-weights-en-gb"
	},
	"files": [
		"model-card.json",
		"postcode-gb.bin",
		"pair-index-gb.bin",
		"fst-en-gb.bin",
		"fst-street-morphology.bin",
		"anchor-lexicon-v1.json",
		"locality-surface-lexicon-v7.json",
		"street-type-lexicon-v3.json",
		"country-surface-lexicon-v1.json",
		"README.md",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!scripts/**",
		"!test/**"
	],
	"exports": {
		"./*": "./*"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/neural-weights-en-us": "workspace:*",
		"@mailwoman/platform": "workspace:*"
	},
	"devDependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*"
	},
	"mailwoman": {
		"baseWeights": "@mailwoman/neural-weights-en-us"
	}
}
