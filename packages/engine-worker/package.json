{
	"name": "@mailwoman/engine-worker",
	"version": "0.0.0",
	"private": true,
	"description": "The Cloudflare Worker that parses and geocodes for the hosted API, running the browser pipeline with gazetteer lookups sent to the gazetteer Worker.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"workerd": "./lib/*.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"workerd": "./lib/index.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"workerd": "./lib/*.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"scripts": {
		"deploy:dry-run": "wrangler deploy --dry-run"
	},
	"dependencies": {
		"@mailwoman/api": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/gazetteer-worker": "workspace:*",
		"@mailwoman/mtf": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*",
		"mailwoman": "workspace:*",
		"onnxruntime-web": "1.31.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261029.1",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
