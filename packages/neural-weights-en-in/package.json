{
	"name": "@mailwoman/neural-weights-en-in",
	"version": "9.1.0",
	"description": "Indian English (en-IN) weights overlay for mailwoman — data-only; shares the base model with @mailwoman/neural-weights-en-us and ships the IN placetype-pair index.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/neural-weights-en-in"
	},
	"files": [
		"model-card.json",
		"pair-index-in.bin",
		"README.md",
		"*.ts",
		"**/*.ts",
		"!*.test.ts",
		"!**/*.test.ts",
		"!scripts/**",
		"!test/**"
	],
	"type": "module",
	"exports": {
		"./*": "./*"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/neural-weights-en-us": "workspace:*"
	},
