		},
		"./us/street-suffix": {
			"node": "./lib/us/street-suffix.ts",
			"default": "./out/us/street-suffix.js",
			"types": "./out/us/street-suffix.d.ts"
		},
		"./us/unit-designator": {
			"node": "./lib/us/unit-designator.ts",
			"default": "./out/us/unit-designator.js",
			"types": "./out/us/unit-designator.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"type-fest": "^5.9.0"
	},
	"devDependencies": {
		"@mailwoman/annotations": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"path-ts": "^2.3.0"
	}
}
