			"default": "./out/kr/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"type-fest": "^5.9.0"
	},
	"devDependencies": {
		"@mailwoman/annotations": "workspace:*"
	}
}
