{
	"name": "@mailwoman/corpus",
	"version": "9.2.0",
	"description": "Mailwoman corpus pipeline: BIO-labeled dataset builder for the neural classifier.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/corpus"
	},
	"files": [
		"data/**",
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test-kit/**/*",
		"!test/**"
	],
	"type": "module",
	"imports": {
		"#adapters/utils": {
			"node": "./src/adapters/utils/index.ts",
			"default": "./out/src/adapters/utils/index.js",
			"types": "./out/src/adapters/utils/index.d.ts"
		},
		"#runner": {
			"node": "./src/runner.ts",
			"default": "./out/src/runner.js",
			"types": "./out/src/runner.d.ts"
		},
		"#synthesizers/utils": {
			"node": "./src/synthesizers/utils.ts",
			"default": "./out/src/synthesizers/utils.js",
			"types": "./out/src/synthesizers/utils.d.ts"
		},
		"#test-kit": "./test-kit/index.ts",
		"#test-kit/shard-recipe": "./test-kit/shard-recipe.ts",
		"#types": {
			"node": "./src/types.ts",
			"default": "./out/src/types.js",
			"types": "./out/src/types.d.ts"
		},
		"#utils": {
			"node": "./src/utils/index.ts",
			"default": "./out/src/utils/index.js",
			"types": "./out/src/utils/index.d.ts"
		},
		"#utils/*": {
			"node": "./src/utils/*.ts",
			"default": "./out/src/utils/*.js",
			"types": "./out/src/utils/*.d.ts"
		},
		"#codex/*": {
			"node": "./src/codex/*.ts",
			"default": "./out/src/codex/*.js",
			"types": "./out/src/codex/*.d.ts"
		},
		"#synthesizers/*": {
			"node": "./src/synthesizers/*.ts",
			"default": "./out/src/synthesizers/*.js",
			"types": "./out/src/synthesizers/*.d.ts"
		},
		"#tools": {
			"node": "./src/tools/index.ts",
			"default": "./out/src/tools/index.js",
			"types": "./out/src/tools/index.d.ts"
		},
		"#adapters/*": {
			"node": "./src/adapters/*.ts",
			"default": "./out/src/adapters/*.js",
			"types": "./out/src/adapters/*.d.ts"
		},
		"#parquet-wrapper": {
			"node": "./src/parquet-wrapper/index.ts",
			"default": "./out/src/parquet-wrapper/index.js",
			"types": "./out/src/parquet-wrapper/index.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./src/index.ts",
			"default": "./out/src/index.js",
			"types": "./out/src/index.d.ts"
		},
		"./types": {
			"node": "./src/types.ts",
			"default": "./out/src/types.js",
			"types": "./out/src/types.d.ts"
		},
		"./data/*": "./data/*",
		"./utils": {
			"node": "./src/utils/index.ts",
			"default": "./out/src/utils/index.js",
			"types": "./out/src/utils/index.d.ts"
		},
