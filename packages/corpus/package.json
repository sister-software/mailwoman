{
	"name": "@mailwoman/corpus",
	"version": "10.1.0",
	"description": "Mailwoman corpus pipeline: BIO-labeled dataset builder for the neural classifier.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/corpus"
	},
	"files": [
		"data/**",
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#build": {
			"types": "./out/build.d.ts",
			"node": "./lib/build.ts",
			"default": "./out/build.js"
		},
		"#runner": {
			"types": "./out/runner.d.ts",
			"node": "./lib/runner.ts",
			"default": "./out/runner.js"
		},
		"#synthesizers/utils": {
			"types": "./out/synthesizers/utils.d.ts",
			"node": "./lib/synthesizers/utils.ts",
			"default": "./out/synthesizers/utils.js"
		},
		"#test-kit": "./lib/test-kit.ts",
		"#test-kit/corpus-recipe": "./lib/test-kit/corpus-recipe.ts",
		"#types": {
			"types": "./out/types.d.ts",
			"node": "./lib/types.ts",
			"default": "./out/types.js"
		},
		"#utils": {
			"types": "./out/utils.d.ts",
			"node": "./lib/utils.ts",
			"default": "./out/utils.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./data/*": "./data/*",
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/ban": "workspace:*",
		"@mailwoman/bdc": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/evidence": "workspace:*",
		"@mailwoman/normalize": "workspace:*",
		"@mailwoman/query-shape": "workspace:*",
		"@mailwoman/record": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@mailwoman/tiger": "workspace:*",
		"apache-arrow": "^21.2.0",
		"fastest-levenshtein": "^1.0.16",
		"parquet-wasm": "0.9.0",
		"path-ts": "^2.5.0",
		"read-excel-file": "^9.3.10",
		"spliterator": "^9.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"adm-zip": "^0.6.1",
		"kysely": "^0.29.6",
		"write-excel-file": "^4.1.1"
	}
}
