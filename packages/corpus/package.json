{
	"name": "@mailwoman/corpus",
	"version": "9.4.0",
	"description": "Mailwoman corpus pipeline: BIO-labeled dataset builder for the neural classifier.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/corpus"
	},
	"files": [
		"data/**",
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"imports": {
		"#adapters/utils": {
			"types": "./out/adapters/utils/index.d.ts",
			"node": "./lib/adapters/utils/index.ts",
			"default": "./out/adapters/utils/index.js"
		},
		"#runner": {
			"types": "./out/runner.d.ts",
			"node": "./lib/runner.ts",
			"default": "./out/runner.js"
		},
		"#synthesizers/utils": {
			"types": "./out/synthesizers/utils.d.ts",
			"node": "./lib/synthesizers/utils.ts",
			"default": "./out/synthesizers/utils.js"
		},
		"#test-kit": "./lib/test-kit/index.ts",
		"#test-kit/corpus-recipe": "./lib/test-kit/corpus-recipe.ts",
		"#types": {
			"types": "./out/types.d.ts",
			"node": "./lib/types.ts",
			"default": "./out/types.js"
		},
		"#utils": {
			"types": "./out/utils/index.d.ts",
			"node": "./lib/utils/index.ts",
			"default": "./out/utils/index.js"
		},
		"#tools": {
			"types": "./out/tools/index.d.ts",
			"node": "./lib/tools/index.ts",
			"default": "./out/tools/index.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./env": {
			"types": "./out/env.d.ts",
			"node": "./lib/env.ts",
			"default": "./out/env.js"
		},
		"./types": {
			"types": "./out/types.d.ts",
			"node": "./lib/types.ts",
			"default": "./out/types.js"
		},
		"./data/*": "./data/*",
		"./utils": {
			"types": "./out/utils/index.d.ts",
			"node": "./lib/utils/index.ts",
			"default": "./out/utils/index.js"
		},
		"./runner": {
			"types": "./out/runner.d.ts",
			"node": "./lib/runner.ts",
			"default": "./out/runner.js"
		},
		"./build": {
			"types": "./out/build.d.ts",
			"node": "./lib/build.ts",
			"default": "./out/build.js"
		},
		"./synthesizers/*": {
			"types": "./out/synthesizers/*.d.ts",
			"node": "./lib/synthesizers/*.ts",
			"default": "./out/synthesizers/*.js"
		},
		"./recipes/*": {
			"types": "./out/recipes/*.d.ts",
			"node": "./lib/recipes/*.ts",
			"default": "./out/recipes/*.js"
		},
		"./adapters/utils": {
			"types": "./out/adapters/utils/index.d.ts",
			"node": "./lib/adapters/utils/index.ts",
			"default": "./out/adapters/utils/index.js"
		},
		"./adapters": {
			"types": "./out/adapters/index.d.ts",
			"node": "./lib/adapters/index.ts",
			"default": "./out/adapters/index.js"
		},
		"./adapters/*": {
			"types": "./out/adapters/*.d.ts",
			"node": "./lib/adapters/*.ts",
			"default": "./out/adapters/*.js"
		},
		"./tools": {
			"types": "./out/tools/index.d.ts",
			"node": "./lib/tools/index.ts",
			"default": "./out/tools/index.js"
		},
		"./codex/*": {
			"types": "./out/codex/*.d.ts",
			"node": "./lib/codex/*.ts",
			"default": "./out/codex/*.js"
		},
		"./utils/parquet": {
			"types": "./out/utils/parquet.d.ts",
			"node": "./lib/utils/parquet.ts",
			"default": "./out/utils/parquet.js"
		},
		"./tools/postcode-triples": {
			"types": "./out/tools/postcode-triples.d.ts",
			"node": "./lib/tools/postcode-triples.ts",
			"default": "./out/tools/postcode-triples.js"
		},
		"./tools/audit": {
			"types": "./out/tools/audit.d.ts",
			"node": "./lib/tools/audit.ts",
			"default": "./out/tools/audit.js"
		},
		"./tools/gb-title-case": {
			"types": "./out/tools/gb-title-case.d.ts",
			"node": "./lib/tools/gb-title-case.ts",
			"default": "./out/tools/gb-title-case.js"
		},
		"./tools/golden-relabel-street": {
			"types": "./out/tools/golden-relabel-street.d.ts",
			"node": "./lib/tools/golden-relabel-street.ts",
			"default": "./out/tools/golden-relabel-street.js"
		},
		"./tools/overture-subvenue": {
			"types": "./out/tools/overture-subvenue.d.ts",
			"node": "./lib/tools/overture-subvenue.ts",
			"default": "./out/tools/overture-subvenue.js"
		},
		"./tools/sub-venue-lexicon": {
			"types": "./out/tools/sub-venue-lexicon.d.ts",
			"node": "./lib/tools/sub-venue-lexicon.ts",
			"default": "./out/tools/sub-venue-lexicon.js"
		},
		"./tools/sub-venue-promotions": {
			"types": "./out/tools/sub-venue-promotions.d.ts",
			"node": "./lib/tools/sub-venue-promotions.ts",
			"default": "./out/tools/sub-venue-promotions.js"
		},
		"./tools/fetch/download": {
			"types": "./out/tools/fetch/download.d.ts",
			"node": "./lib/tools/fetch/download.ts",
			"default": "./out/tools/fetch/download.js"
		},
		"./tools/fetch/ppd": {
			"types": "./out/tools/fetch/ppd.d.ts",
			"node": "./lib/tools/fetch/ppd.ts",
			"default": "./out/tools/fetch/ppd.js"
		},
		"./utils/tokenize": {
			"types": "./out/utils/tokenize.d.ts",
			"node": "./lib/utils/tokenize.ts",
			"default": "./out/utils/tokenize.js"
		},
		"./utils/golden": {
			"types": "./out/utils/golden.d.ts",
			"node": "./lib/utils/golden.ts",
			"default": "./out/utils/golden.js"
		},
		"./utils/license": {
			"types": "./out/utils/license.d.ts",
			"node": "./lib/utils/license.ts",
			"default": "./out/utils/license.js"
		},
		"./utils/split": {
			"types": "./out/utils/split.d.ts",
			"node": "./lib/utils/split.ts",
			"default": "./out/utils/split.js"
		},
		"./utils/wof-json": {
			"types": "./out/utils/wof-json.d.ts",
			"node": "./lib/utils/wof-json.ts",
			"default": "./out/utils/wof-json.js"
		},
		"./test-kit": {
			"types": "./out/test-kit/index.d.ts",
			"node": "./lib/test-kit/index.ts",
			"default": "./out/test-kit/index.js"
		},
		"./test-kit/corpus-recipe": {
			"types": "./out/test-kit/corpus-recipe.d.ts",
			"node": "./lib/test-kit/corpus-recipe.ts",
			"default": "./out/test-kit/corpus-recipe.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/ban": "workspace:*",
		"@mailwoman/bdc": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/formatter": "workspace:*",
		"@mailwoman/normalize": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@mailwoman/tiger": "workspace:*",
		"apache-arrow": "^21.2.0",
		"fast-glob": "^3.3.3",
		"fastest-levenshtein": "^1.0.16",
		"parquet-wasm": "0.7.2",
		"path-ts": "^2.3.0",
		"read-excel-file": "^9.3.10",
		"spliterator": "^7.0.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"adm-zip": "^0.6.0",
		"kysely": "^0.29.5",
		"write-excel-file": "^4.1.1"
	}
}
