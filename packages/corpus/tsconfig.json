{
	"extends": "@sister.software/tsconfig/node",
	"compilerOptions": {
		"rootDir": "./lib",
		"outDir": "./out",
		"emitDeclarationOnly": false,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["./lib/**/*"],
	"exclude": [
		"./out/**/*",
		"./test/**/*",
		"./**/*.test.ts",
		"./**/*.test.tsx",
		"./fixtures/**/*",
		"./lib/test-kit/**/*"
	],
	"references": [
		{ "path": "../bdc" },
		{ "path": "../sqlite" },
		{ "path": "../core" },
		{ "path": "../codex" },
		{ "path": "../formatter" }
	]
}
