{
	"name": "@mailwoman/license-worker",
	"version": "0.0.0",
	"private": true,
	"description": "The self-service license worker: Stripe webhooks in, signed license tokens out, ledger in D1.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"type": "module",
	"imports": {
		"#test/*": "./test/*.ts",
		"#shop/ids.json": "./lib/shop/ids.json",
		"#*": {
			"workerd": "./lib/*.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./sdk/*": {
			"node": "./lib/sdk/*.ts",
			"default": "./out/sdk/*.js",
			"types": "./out/sdk/*.d.ts"
		},
		"./shop": {
			"node": "./lib/shop/operations.ts",
			"default": "./out/shop/operations.js",
			"types": "./out/shop/operations.d.ts"
		},
		"./env": {
			"node": "./lib/env.ts",
			"default": "./out/env.js",
			"types": "./out/env.d.ts"
		},
		"./dates": {
			"node": "./lib/dates.ts",
			"default": "./out/dates.js",
			"types": "./out/dates.d.ts"
		},
		"./email/provider": {
			"node": "./lib/email/provider.ts",
			"default": "./out/email/provider.js",
			"types": "./out/email/provider.d.ts"
		},
		"./email/cloudflare": {
			"node": "./lib/email/cloudflare.ts",
			"default": "./out/email/cloudflare.js",
			"types": "./out/email/cloudflare.d.ts"
		},
		"./email/render": {
			"node": "./lib/email/render.ts",
			"default": "./out/email/render.js",
			"types": "./out/email/render.d.ts"
		},
		"./fulfil": {
			"node": "./lib/fulfil.ts",
			"default": "./out/fulfil.js",
			"types": "./out/fulfil.d.ts"
		},
		"./ledger/client": {
			"node": "./lib/ledger/client.ts",
			"default": "./out/ledger/client.js",
			"types": "./out/ledger/client.d.ts"
		},
		"./ledger/licenses": {
			"node": "./lib/ledger/licenses.ts",
			"default": "./out/ledger/licenses.js",
			"types": "./out/ledger/licenses.d.ts"
		},
		"./stripe/client": {
			"node": "./lib/stripe/client.ts",
			"default": "./out/stripe/client.js",
			"types": "./out/stripe/client.d.ts"
		},
		"./stripe/handlers": {
			"node": "./lib/stripe/handlers.ts",
			"default": "./out/stripe/handlers.js",
			"types": "./out/stripe/handlers.d.ts"
		},
		"./app": {
			"node": "./lib/app.ts",
			"default": "./out/app.js",
			"types": "./out/app.d.ts"
		},
		"./identifiers": {
			"node": "./lib/identifiers.ts",
			"default": "./out/identifiers.js",
			"types": "./out/identifiers.d.ts"
		},
		"./ledger/schema": {
			"node": "./lib/ledger/schema.ts",
			"default": "./out/ledger/schema.js",
			"types": "./out/ledger/schema.d.ts"
		},
		"./plans": {
			"node": "./lib/plans.ts",
			"default": "./out/plans.js",
			"types": "./out/plans.d.ts"
		},
		"./reconcile": {
			"node": "./lib/reconcile.ts",
			"default": "./out/reconcile.js",
			"types": "./out/reconcile.d.ts"
		},
		"./shop/catalog": {
			"node": "./lib/shop/catalog.ts",
			"default": "./out/shop/catalog.js",
			"types": "./out/shop/catalog.d.ts"
		},
		"./shop/provision": {
			"node": "./lib/shop/provision.ts",
			"default": "./out/shop/provision.js",
			"types": "./out/shop/provision.d.ts"
		},
		"./shop/rehearse": {
			"node": "./lib/shop/rehearse.ts",
			"default": "./out/shop/rehearse.js",
			"types": "./out/shop/rehearse.d.ts"
		},
		"./shop/ids": {
			"node": "./lib/shop/ids.ts",
			"default": "./out/shop/ids.js",
			"types": "./out/shop/ids.d.ts"
		},
		"./signing": {
			"node": "./lib/signing.ts",
			"default": "./out/signing.js",
			"types": "./out/signing.d.ts"
		},
		"./stripe/webhook": {
			"node": "./lib/stripe/webhook.ts",
			"default": "./out/stripe/webhook.js",
			"types": "./out/stripe/webhook.d.ts"
		}
	},
	"scripts": {
		"dev": "wrangler dev --env sandbox",
		"deploy:sandbox": "wrangler deploy --env sandbox",
		"deploy:production": "wrangler deploy --env production",
		"migrate:sandbox": "wrangler d1 migrations apply LICENSE_LEDGER --env sandbox --remote",
		"migrate:production": "wrangler d1 migrations apply LICENSE_LEDGER --env production --remote",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/release-kit": "workspace:*",
		"hono": "^4.13.7",
		"kysely": "^0.29.5",
		"kysely-d1": "^0.4.0",
		"stripe": "^22.6.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260906.1",
		"@vitest/runner": "^4.1.11",
		"@vitest/snapshot": "^4.1.11",
		"vitest": "4.1.11",
		"wrangler": "^4.129.0"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
