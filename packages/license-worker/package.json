{
	"name": "@mailwoman/license-worker",
	"version": "0.0.0",
	"private": true,
	"description": "The self-service license worker: Stripe webhooks in, signed license tokens out, ledger in D1.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"type": "module",
	"imports": {
		"#test/*": "./test/*.ts",
		"#shop/ids.json": "./lib/shop/ids.json",
		"#email/template": {
			"types": "./out/email/template.d.ts",
			"workerd": "./lib/email/template.tsx",
			"default": "./out/email/template.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"workerd": "./lib/*.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"scripts": {
		"dev": "wrangler dev -c wrangler.sandbox.toml",
		"deploy:sandbox": "wrangler deploy -c wrangler.sandbox.toml",
		"migrate:sandbox": "wrangler d1 migrations apply LICENSE_LEDGER -c wrangler.sandbox.toml --remote",
		"migrate:production": "wrangler d1 migrations apply LICENSE_LEDGER --remote",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/universe": "workspace:*",
		"@react-email/components": "^1.0.12",
		"hono": "^4.13.13",
		"kysely": "^0.29.6",
		"kysely-d1": "^0.4.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"stripe": "^23.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20261006.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/runner": "^4.1.11",
		"@vitest/snapshot": "^4.1.11",
		"vitest": "^4.1.11",
		"wrangler": "^4.148.0"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
