{
	"name": "@mailwoman/map-tui",
	"version": "9.2.0",
	"description": "Terminal vector-tile map renderer — braille map frames for TUIs, from PMTiles.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/map-tui"
	},
	"bin": "./out/cli.js",
	"files": [
		"out/",
		"*.ts",
		"**/*.ts",
		"!*.test.ts",
		"!**/*.test.ts",
		"!test/",
		"!scripts/",
		"!__snapshots__/"
	],
	"type": "module",
	"imports": {
		"#*": {
			"node": "./*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./cli-args": {
			"node": "./cli-args.ts",
			"default": "./out/cli-args.js",
			"types": "./out/cli-args.d.ts"
		},
		"./frame": {
			"node": "./frame.ts",
			"default": "./out/frame.js",
			"types": "./out/frame.d.ts"
		},
		"./raster": {
			"node": "./raster.ts",
			"default": "./out/raster.js",
			"types": "./out/raster.d.ts"
		},
		"./input": {
			"node": "./input.ts",
			"default": "./out/input.js",
			"types": "./out/input.d.ts"
		},
		"./mercator": {
			"node": "./mercator.ts",
			"default": "./out/mercator.js",
			"types": "./out/mercator.d.ts"
		},
		"./renderer": {
			"node": "./renderer.ts",
			"default": "./out/renderer.js",
			"types": "./out/renderer.d.ts"
		},
		"./tile-source": {
			"node": "./tile-source.ts",
			"default": "./out/tile-source.js",
			"types": "./out/tile-source.d.ts"
		},
		"./style": {
			"node": "./style.ts",
			"default": "./out/style.js",
			"types": "./out/style.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mapbox/vector-tile": "^2.0.3",
		"@sister.software/asciify": "^4.1.0",
		"htmlparser2": "^10",
		"pbf": "^4.0.1",
		"pmtiles": "^4.5.0"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
