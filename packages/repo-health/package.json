{
	"name": "@mailwoman/repo-health",
	"version": "9.2.0",
	"private": true,
	"description": "Repository health checks as a registry — each inspects the checkout and returns diagnostics or pass/fail; a check never writes, and the two exports that do (the debt baseline, and the module-move fixes) sit beside the registry rather than in it.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/repo-health"
	},
	"files": [
		"lib",
		"out",
		"baseline.json",
		"README.md",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/corpus": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/release-kit": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"esbuild": "0.28.2",
		"mailwoman": "workspace:*",
		"path-ts": "^2.5.0",
		"spliterator": "^8.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@vvago/vale": "^3.23.0"
	}
}
