{
	"name": "@mailwoman/structures",
	"version": "10.7.0",
	"private": true,
	"description": "Building footprints, 3D building models, landmark models and tree heights, with a license decision for each publisher",
	"keywords": [
		"3d-buildings",
		"citygml",
		"landmarks",
		"license",
		"plateau"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/structures"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"lib/**/*.ts",
		"!**/*.test.ts"
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"scripts": {
		"test": "vitest run"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
