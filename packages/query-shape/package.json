{
	"name": "@mailwoman/query-shape",
	"version": "9.3.0",
	"description": "Cheap structural priors for the runtime pipeline: character class, segmentation, known-format detection. Pure functions, no ML.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/query-shape"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#index": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./character-class": {
			"types": "./out/character-class.d.ts",
			"node": "./lib/character-class.ts",
			"default": "./out/character-class.js"
		},
		"./types": {
			"types": "./out/types.d.ts",
			"node": "./lib/types.ts",
			"default": "./out/types.js"
		},
		"./compute": {
			"types": "./out/compute.d.ts",
			"node": "./lib/compute.ts",
			"default": "./out/compute.js"
		},
		"./known-formats": {
			"types": "./out/known-formats.d.ts",
			"node": "./lib/known-formats.ts",
			"default": "./out/known-formats.js"
		},
		"./region-abbreviations": {
			"types": "./out/region-abbreviations.d.ts",
			"node": "./lib/region-abbreviations.ts",
			"default": "./out/region-abbreviations.js"
		},
		"./segmentation": {
			"types": "./out/segmentation.d.ts",
			"node": "./lib/segmentation.ts",
			"default": "./out/segmentation.js"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
