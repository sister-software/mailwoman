{
	"name": "@mailwoman/sqlite",
	"version": "9.2.0",
	"description": "The one way a Mailwoman SQLite connection is opened: a typed Kysely client over node:sqlite, plus the sealed-artifact lifecycle.",
	"keywords": [
		"kysely",
		"sqlite"
	],
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/sqlite"
	},
	"files": [
		"out/",
		"*.ts",
		"!*.test.ts",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./client": {
			"node": "./lib/client.ts",
			"default": "./out/client.js",
			"types": "./out/client.d.ts"
		},
		"./introspection": {
			"node": "./lib/introspection.ts",
			"default": "./out/introspection.js",
			"types": "./out/introspection.d.ts"
		},
		"./dialect": {
			"node": "./lib/dialect.ts",
			"default": "./out/dialect.js",
			"types": "./out/dialect.d.ts"
		},
		"./dialect-config": {
			"node": "./lib/dialect-config.ts",
			"default": "./out/dialect-config.js",
			"types": "./out/dialect-config.d.ts"
		},
		"./sealed": {
			"node": "./lib/sealed.ts",
			"default": "./out/sealed.js",
			"types": "./out/sealed.d.ts"
		},
		"./sealed-db": {
			"node": "./lib/sealed-db.ts",
			"default": "./out/sealed-db.js",
			"types": "./out/sealed-db.d.ts"
		},
		"./database-schema": {
			"node": "./lib/database-schema.ts",
			"default": "./out/database-schema.js",
			"types": "./out/database-schema.d.ts"
		},
		"./batched": {
			"node": "./lib/batched.ts",
			"default": "./out/batched.js",
			"types": "./out/batched.d.ts"
		},
		"./schema-columns": {
			"node": "./lib/schema-columns.ts",
			"default": "./out/schema-columns.js",
			"types": "./out/schema-columns.d.ts"
		},
		"./sealed-build": {
			"node": "./lib/sealed-build.ts",
			"default": "./out/sealed-build.js",
			"types": "./out/sealed-build.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"kysely": "^0.29.5",
		"path-ts": "^2.3.0"
	},
	"devDependencies": {
		"@mailwoman/core": "workspace:*"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
