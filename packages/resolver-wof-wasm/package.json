{
	"name": "@mailwoman/resolver-wof-wasm",
	"version": "9.3.0",
	"description": "Who's On First WASM resolver — browser-side PlaceLookup backed by @sqlite.org/sqlite-wasm. Drop-in replacement for @mailwoman/resolver-wof-sqlite when you need a static-asset deploy (Phase B of the demo plan).",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/resolver-wof-wasm"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"node": "./lib/*.ts",
			"default": "./out/*.js",
			"types": "./out/*.d.ts"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"node": "./lib/index.ts",
			"default": "./out/index.js",
			"types": "./out/index.d.ts"
		},
		"./env": {
			"node": "./lib/env.ts",
			"default": "./out/env.js",
			"types": "./out/env.d.ts"
		},
		"./browser-cascade": {
			"node": "./lib/browser-cascade.ts",
			"default": "./out/browser-cascade.js",
			"types": "./out/browser-cascade.d.ts"
		},
		"./loader": {
			"node": "./lib/loader.ts",
			"default": "./out/loader.js",
			"types": "./out/loader.d.ts"
		},
		"./lookup": {
			"node": "./lib/lookup.ts",
			"default": "./out/lookup.js",
			"types": "./out/lookup.d.ts"
		},
		"./httpvfs/resolver": {
			"node": "./lib/httpvfs/resolver.ts",
			"default": "./out/httpvfs/resolver.js",
			"types": "./out/httpvfs/resolver.d.ts"
		},
		"./httpvfs/street": {
			"node": "./lib/httpvfs/street.ts",
			"default": "./out/httpvfs/street.js",
			"types": "./out/httpvfs/street.d.ts"
		},
		"./httpvfs/poi": {
			"node": "./lib/httpvfs/poi.ts",
			"default": "./out/httpvfs/poi.js",
			"types": "./out/httpvfs/poi.d.ts"
		},
		"./httpvfs/rows": {
			"node": "./lib/httpvfs/rows.ts",
			"default": "./out/httpvfs/rows.js",
			"types": "./out/httpvfs/rows.d.ts"
		},
		"./host-assets": {
			"node": "./lib/host-assets.ts",
			"default": "./out/host-assets.js",
			"types": "./out/host-assets.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@sqlite.org/sqlite-wasm": "^3.53.0-build1",
		"h3-js": "^4.5.0",
		"sql.js-httpvfs": "^0.8.12",
		"zod": "^4.5.4"
	}
}
