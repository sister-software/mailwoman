{
	"name": "@mailwoman/api-kit",
	"version": "9.3.0",
	"description": "API plumbing for Mailwoman's HTTP surfaces — Hono node serve wrapper, OpenAPI emit helpers, shared wire atoms. Plumbing only: domain schemas live with their routes.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/api-kit"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./metrics": {
			"types": "./out/metrics.d.ts",
			"node": "./lib/metrics.ts",
			"default": "./out/metrics.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@hono/zod-openapi": "^1.6.3",
		"@mailwoman/core": "workspace:*",
		"hono": "^4.13.7",
		"zod": "^4.5.4"
	}
}
