{
	"name": "@mailwoman/activity-lexicon",
	"version": "10.2.1",
	"description": "Reviewed surface forms for activity concepts — the phrases a person types for what they want to do, each carrying the record that attests it and the locales it is used in.",
	"keywords": [
		"activity",
		"lexicon",
		"phrases",
		"provenance"
	],
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/activity-lexicon"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"data/**/*.json",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/geographic-model": "workspace:*",
		"@mailwoman/variant-aliases": "workspace:*"
	},
	"devDependencies": {
		"path-ts": "^2.5.0"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
