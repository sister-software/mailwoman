{
	"name": "@mailwoman/mcp",
	"version": "9.3.0",
	"description": "MCP server — mailwoman's spatial toolset for agents (parse, geocode, poi_search, overpass_export, layer_manifest).",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/mcp"
	},
	"bin": {
		"mailwoman-mcp": "./out/cli.js"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"*.ts",
		"*.tsx",
		"**/*.ts",
		"**/*.tsx",
		"!*.test.ts",
		"!*.test.tsx",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!test/**"
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./layer-guards": {
			"types": "./out/layer-guards.d.ts",
			"node": "./lib/layer-guards.ts",
			"default": "./out/layer-guards.js"
		},
		"./tools": {
			"types": "./out/tools.d.ts",
			"node": "./lib/tools.ts",
			"default": "./out/tools.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/bdc": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/filer": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/neural-weights-en-us": "workspace:*",
		"@mailwoman/poi-taxonomy": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"mailwoman": "workspace:*",
		"zod": "^4.5.4"
	},
	"peerDependencies": {
		"@mailwoman/resolver-wof-sqlite": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@mailwoman/resolver-wof-sqlite": {
			"optional": true
		}
	}
}
