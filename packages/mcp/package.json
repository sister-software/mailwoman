{
	"name": "@mailwoman/mcp",
	"version": "10.1.0",
	"description": "MCP server — mailwoman's toolset for agents: address parsing and geocoding, POI search and Overpass export, layer manifests, plausibility checks, and FCC broadband and filer lookups.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/mcp"
	},
	"bin": {
		"mailwoman-mcp": "./out/cli/main.js"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"README.md",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"cli/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#cli/*": {
			"types": "./out/cli/*.d.ts",
			"node": "./cli/*.ts",
			"default": "./out/cli/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./cli/*": {
			"types": "./out/cli/*.d.ts",
			"node": "./cli/*.ts",
			"default": "./out/cli/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@mailwoman/bdc": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/filer": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/neural-weights-en-us": "workspace:*",
		"@mailwoman/poi-taxonomy": "workspace:*",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.32.0",
		"mailwoman": "workspace:*",
		"path-ts": "^2.5.0",
		"zod": "^4.6.5"
	}
}
