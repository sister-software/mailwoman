{
	"extends": "@sister.software/tsconfig/web",
	"compilerOptions": {
		"rootDir": "./lib",
		"outDir": "./out",
		"emitDeclarationOnly": false,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"types": ["vite/client"]
	},
	"include": ["./lib/**/*"],
	"exclude": [
		"./out/**/*",
		"./dist/**/*",
		"./test/**",
		"./**/*.test.ts",
		"./**/*.test.tsx",
		"./vite.config.ts",
		"./playwright.config.ts"
	],
	"references": [
		{ "path": "../cartographer" },
		{ "path": "../core" },
		{ "path": "../dossier" },
		{ "path": "../opportunity-map" },
		{ "path": "../react" },
		{ "path": "../route-scenarios" }
	]
}
