{
	"name": "@mailwoman/opportunity-app",
	"version": "1.0.0",
	"private": true,
	"description": "The private, undeployed opportunity map application: the building, route and district collections of @mailwoman/opportunity-map over the synthetic Example District, with building selection, scenario controls and a keyboard path, as a React + Vite app",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 7772 --strictPort",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@mailwoman/cartographer": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/dossier": "workspace:*",
		"@mailwoman/opportunity-map": "workspace:*",
		"@mailwoman/react": "workspace:*",
		"@mailwoman/route-scenarios": "workspace:*",
		"@mailwoman/universe": "workspace:*",
		"maplibre-gl": "^6.11.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-map-gl": "^8.1.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"vite": "^8.3.2"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
