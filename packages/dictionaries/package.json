{
	"name": "@mailwoman/dictionaries",
	"version": "10.7.0",
	"description": "Vendored libpostal dictionaries, libaddressinput address metadata and curated reference tables, with their path resolvers and download tools",
	"keywords": [
		"address",
		"dictionaries",
		"libaddressinput",
		"libpostal"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/dictionaries"
	},
	"files": [
		"out/**/*.js",
		"out/**/*.js.map",
		"out/**/*.d.ts",
		"out/**/*.d.ts.map",
		"data/**/*",
		"README.md",
		"THIRD_PARTY_NOTICES.md",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"sdk/**/*.ts",
		"!**/*.test.ts",
		"!**/*.test.tsx"
	],
	"type": "module",
	"imports": {
		"#sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		},
		"./sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"./*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"path-ts": "^2.5.0",
		"spliterator": "^9.2.1"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	}
}
