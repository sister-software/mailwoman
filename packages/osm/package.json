{
	"name": "@mailwoman/osm",
	"version": "4.16.2",
	"description": "OpenStreetMap rooftop address-point ingestion — builds per-country ODbL precision extracts on the situs address-point schema.",
	"keywords": [
		"address-point",
		"geocoding",
		"geospatial",
		"openstreetmap"
	],
	"homepage": "https://github.com/sister-software/mailwoman",
	"bugs": {
		"url": "https://github.com/sister-software/mailwoman/issues"
	},
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git",
		"directory": "packages/osm"
	},
	"type": "module",
	"imports": {
		"#*": {
			"types": "./out/*.d.ts",
			"node": "./lib/*.ts",
			"default": "./out/*.js"
		}
	},
	"exports": {
		"./package.json": "./package.json",
		"./scripts/*": {
			"types": "./out/scripts/*.d.ts",
			"node": "./lib/scripts/*.ts",
			"default": "./out/scripts/*.js"
		},
		"./sdk": {
			"types": "./out/sdk/index.d.ts",
			"node": "./lib/sdk/index.ts",
			"default": "./out/sdk/index.js"
		},
		"./sdk/*": {
			"types": "./out/sdk/*.d.ts",
			"node": "./lib/sdk/*.ts",
			"default": "./out/sdk/*.js"
		},
		"./overpass/*": {
			"types": "./out/overpass/*.d.ts",
			"node": "./lib/overpass/*.ts",
			"default": "./out/overpass/*.js"
		},
		".": {
			"types": "./out/index.d.ts",
			"node": "./lib/index.ts",
			"default": "./out/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run"
	},
	"dependencies": {
		"@mailwoman/core": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"h3-js": "^4.5.0",
		"kysely": "^0.29.5",
		"path-ts": "^2.3.0"
	},
	"engines": {
		"node": ">=24.18.0"
	}
}
