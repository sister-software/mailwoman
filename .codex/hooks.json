{
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/lib/dev-mcp/hooks/ci-completion.ts\"",
						"timeout": 30,
						"statusMessage": "CI completion check"
					},
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/lib/dev-mcp/hooks/vale/response/check/codex.ts\"",
						"timeout": 30,
						"statusMessage": "Vale prose check"
					}
				]
			}
		]
	}
}
