# The committed copy of the compose environment. `.env` itself is gitignored repo-wide, so this
# file is the version-controlled original: `cp env.defaults .env` before the first compose command.
COMPOSE_PROJECT_NAME=pelias
# The rig's own data — PBFs, polyline cuts, the ES index, the built interpolation databases.
# Lives outside the repo: it is tens of gigabytes and none of it is source.
DATA_DIR=/mnt/playpen/mailwoman-data/pelias-rig/data
# Read-only source trees we already hold under $MAILWOMAN_DATA_ROOT, mounted rather than copied.
OA_EXTRACTED=/mnt/playpen/mailwoman-data/openaddresses/extracted
TIGER_2024=/mnt/playpen/mailwoman-data/tiger/2024
