{
	"$schema": "https://unpkg.com/release-it/schema/release-it.json",
	"plugins": {
		"@release-it-plugins/workspaces": {
			"workspaces": [
				"packages/activity-lexicon",
				"packages/address-id",
				"packages/ancestrie",
				"packages/annotations",
				"packages/api",
				"packages/api-kit",
				"packages/ban",
				"packages/bdc",
				"packages/cartographer",
				"packages/coastal",
				"packages/codex",
				"packages/core",
				"packages/corpus",
				"packages/fastify",
				"packages/filer",
				"packages/flood",
				"packages/formatter",
				"packages/geographic-model",
				"packages/kind-classifier",
				"packages/libpostal",
				"packages/locale-gate",
				"packages/mailwoman",
				"packages/map-tui",
				"packages/match",
				"packages/mcp",
				"packages/neural",
				"packages/neural-web",
				"packages/neural-weights-de-de",
				"packages/neural-weights-en-au",
				"packages/neural-weights-en-gb",
				"packages/neural-weights-en-in",
				"packages/neural-weights-en-nz",
				"packages/neural-weights-en-us",
				"packages/neural-weights-es-es",
				"packages/neural-weights-fr-fr",
				"packages/neural-weights-it-it",
				"packages/nominatim",
				"packages/normalize",
				"packages/nuts-lookup",
				"packages/photon",
				"packages/phrase-grouper",
				"packages/poi-taxonomy",
				"packages/query-shape",
				"packages/react",
				"packages/record",
				"packages/registry",
				"packages/resolver",
				"packages/resolver-wof-sqlite",
				"packages/resolver-wof-wasm",
				"packages/sentencepiece-wasm",
				"packages/soil",
				"packages/spatial",
				"packages/sqlite",
				"packages/tiger",
				"packages/timezone-lookup",
				"packages/un-locode-lookup",
				"packages/variant-aliases",
				"packages/zoning"
			],
			"publish": true,
			"publishCommand": "node scripts/publish-workspace.ts",
			"skipChecks": true
		}
	},
	"npm": false,
	"git": {
		"commitMessage": "release: v${version}",
		"tagName": "v${version}",
		"tagAnnotation": "Release v${version}",
		"requireCleanWorkingDir": true,
		"requireBranch": "main"
	},
	"github": {
		"release": true,
		"releaseName": "v${version}",
		"releaseNotes": "git log --pretty=format:'* %s (%h)' ${latestTag}...HEAD --no-merges"
	},
	"hooks": {
		"before:init": [
			"echo 'Pre-flight: compile + copy-weights (tests skipped — PR CI already validated)'",
			"yarn compile",
			"node scripts/copy-weights.ts"
		],
		"after:bump": "yarn oxfmt package.json '**/package.json'",
		"after:release": "echo 'Released v${version}'"
	}
}
