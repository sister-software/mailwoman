{
	"name": "@mailwoman/universe",
	"version": "9.2.0",
	"private": true,
	"description": "Mailwoman monorepo workspace root.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git"
	},
	"workspaces": [
		"docs",
		"packages/activity-lexicon",
		"packages/address-id",
		"packages/ancestrie",
		"packages/annotations",
		"packages/api",
		"packages/api-kit",
		"packages/ban",
		"packages/bdc",
		"packages/cartographer",
		"packages/coastal",
		"packages/codex",
		"packages/core",
		"packages/corpus",
		"packages/dev-mcp",
		"packages/release-kit",
		"packages/repo-health",
		"packages/ops-cli",
		"packages/fastify",
		"packages/filer",
		"packages/flood",
		"packages/formatter",
		"packages/geocode-oracle",
		"packages/geographic-model",
		"packages/kind-classifier",
		"packages/libpostal",
		"packages/locale-hint",
		"packages/mailwoman",
		"packages/map-tui",
		"packages/match",
		"packages/mcp",
		"packages/neural",
		"packages/neural-web",
		"packages/neural-weights-base-latn",
		"packages/neural-weights-de-de",
		"packages/neural-weights-en-au",
		"packages/neural-weights-en-gb",
		"packages/neural-weights-en-in",
		"packages/neural-weights-en-nz",
		"packages/neural-weights-en-us",
		"packages/neural-weights-es-es",
		"packages/neural-weights-fr-fr",
		"packages/neural-weights-it-it",
		"packages/nominatim",
		"packages/normalize",
		"packages/nuts-lookup",
		"packages/osm",
		"packages/photon",
		"packages/phrase-grouper",
		"packages/poi-taxonomy",
		"packages/query-shape",
		"packages/react",
		"packages/record",
		"packages/registry",
		"packages/resolver",
		"packages/resolver-wof-sqlite",
		"packages/resolver-wof-wasm",
		"packages/sentencepiece-wasm",
		"packages/soil",
		"packages/spatial",
		"packages/sqlite",
		"packages/tiger",
		"packages/tile-worker",
		"packages/timezone-lookup",
		"packages/un-locode-lookup",
		"packages/variant-aliases",
		"packages/zoning"
	],
	"type": "module",
	"scripts": {
		"ci:docs": "run-s compile docs:build",
		"ci:smoke": "yarn mwops release smoke-clean-install",
		"ci:test": "vitest --run",
		"ci:test:fast": "vitest --run --config vitest.fast.config.ts",
		"ci:test:slow": "vitest --run --config vitest.slow.config.ts",
		"ci:test:lexicon-full": "vitest --run --config vitest.full.config.ts",
		"ci:test:pair-index-parity": "vitest --run pair/index-card-parity",
		"ci:tile-worker": "run-s compile",
		"compile": "NODE_OPTIONS=\"--max-old-space-size=3000\" tsc -b",
		"compile:clean": "tsc -b --clean",
		"docs:build": "yarn workspace @mailwoman/docs build",
		"fix:oxlint": "oxlint --fix --fix-suggestions && oxlint --fix --fix-suggestions",
		"fix:python": "uvx ruff@0.15.20 check --fix corpus-python && uvx ruff@0.15.20 format corpus-python",
		"format": "oxfmt .",
		"lint": "run-s lint:oxlint lint:oxfmt lint:python lint:prose health",
		"lint:fix": "run-s fix:oxlint format fix:python",
		"lint:oxfmt": "oxfmt --check .",
		"lint:oxlint": "oxlint",
		"lint:prose": "run-s lint:prose:vocab lint:prose:code",
		"lint:python": "uvx ruff@0.15.20 check corpus-python && uvx ruff@0.15.20 format --check corpus-python && python3 corpus-python/scripts/verify_toolchain.py && yarn python:typecheck && yarn python:security",
		"python:security": "cd corpus-python && uv run --extra dev --extra train bandit -c pyproject.toml -r src",
		"python:typecheck": "cd corpus-python && uv run --extra dev --extra train mypy",
		"health": "run-s health:debt health:architecture health:manifests health:knip health:exports health:test-contract health:duplicates",
		"health:architecture": "depcruise packages scripts --config dependency-cruiser.config.cjs",
		"health:debt": "yarn mwops health debt",
		"health:debt:update": "yarn mwops health baseline debt",
		"mwops": "node packages/ops-cli/lib/cli.ts",
		"health:duplicates": "jscpd --config jscpd.json",
		"health:exports": "yarn mwops health exports",
		"health:knip": "knip --files --dependencies --reporter compact",
		"health:manifests": "sherif -i @duckdb/node-api -i @types/node -i typescript",
		"health:test-contract": "yarn mwops health test-contract",
		"prepare": "husky",
		"release:preflight": "yarn mwops release preflight",
		"release": "release-it",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"test:integration": "vitest --config vitest.slow.config.ts",
		"test:unit": "vitest --config vitest.fast.config.ts",
		"typecheck": "run-s compile typecheck:tests typecheck:docs",
		"typecheck:docs": "tsc -p docs/tsconfig.json --noEmit",
		"typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
		"typecheck:tests": "yarn mwops health typecheck-tests",
		"lint:prose:vocab": "yarn workspace @mailwoman/docs lint:prose:vocab",
		"lint:prose:code": "node_modules/@vvago/vale/bin/vale --config docs/.vale-code.ini $(git ls-files '*.ts' '*.tsx' 'corpus-python/*.py')"
	},
	"devDependencies": {
		"@duckdb/node-api": "^1.5.5-r.4",
		"@mailwoman/core": "workspace:*",
		"@release-it-plugins/workspaces": "^6.0.0",
		"@sister.software/oxfmt-config": "^13.0.1",
		"@sister.software/oxlint-config": "^13.0.1",
		"@sister.software/tsconfig": "^13.0.1",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/regenerate": "^1.4.3",
		"@vitest/coverage-v8": "4.1.11",
		"dependency-cruiser": "^18.2.0",
		"husky": "^9.1.7",
		"jscpd": "^5.1.1",
		"knip": "^6.34.0",
		"npm-run-all": "^4.1.5",
		"onnxruntime-web": "1.29.0",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"path-ts": "^2.3.0",
		"release-it": "^19.2.4",
		"sherif": "^1.13.0",
		"spliterator": "^6.4.1",
		"ts-morph": "^28.0.0",
		"typescript": "^7.0.2",
		"vitest": "4.1.11",
		"zx": "^8.8.5"
	},
	"resolutions": {
		"http-proxy-middleware@^2.0.9": "2.0.10",
		"serialize-javascript": "^7.0.5",
		"sockjs/uuid": "^11.1.1",
		"undici": "^6.24.0",
		"websocket-driver": "^0.7.5"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"packageManager": "yarn@4.18.0"
}
