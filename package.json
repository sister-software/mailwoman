{
	"name": "@mailwoman/universe",
	"version": "9.1.0",
	"private": true,
	"description": "Mailwoman monorepo workspace root.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git"
	},
	"workspaces": [
		"packages/mailwoman",
		"packages/annotations",
		"packages/api-kit",
		"packages/api",
		"packages/nominatim",
		"packages/photon",
		"packages/libpostal",
		"packages/timezone-lookup",
		"packages/un-locode-lookup",
		"packages/nuts-lookup",
		"packages/core",
		"packages/resolver",
		"packages/spatial",
		"packages/tiger",
		"packages/osm",
		"packages/ban",
		"packages/bdc",
		"packages/cartographer",
		"packages/codex",
		"packages/corpus",
		"packages/formatter",
		"packages/geocode-oracle",
		"packages/record",
		"packages/match",
		"packages/registry",
		"packages/filer",
		"packages/address-id",
		"packages/sentencepiece-wasm",
		"packages/neural",
		"packages/neural-web",
		"packages/neural-weights-en-us",
		"packages/neural-weights-fr-fr",
		"packages/neural-weights-en-gb",
		"packages/neural-weights-en-au",
		"packages/neural-weights-en-nz",
		"packages/neural-weights-it-it",
		"packages/neural-weights-es-es",
		"packages/neural-weights-de-de",
		"packages/neural-weights-en-in",
		"packages/normalize",
		"packages/kind-classifier",
		"packages/locale-gate",
		"packages/variant-aliases",
		"packages/phrase-grouper",
		"packages/poi-taxonomy",
		"packages/mcp",
		"packages/react",
		"packages/fastify",
		"packages/query-shape",
		"packages/resolver-wof-sqlite",
		"packages/resolver-wof-wasm",
		"packages/tile-worker",
		"packages/map-tui",
		"docs",
		"packages/neural-weights-base-latn"
	],
	"type": "module",
	"scripts": {
		"ci:docs": "run-s compile docs:build",
		"ci:smoke": "node scripts/smoke-clean-install.ts",
		"ci:test": "vitest --run",
		"ci:test:fast": "vitest --run --exclude './packages/mailwoman/test/**' --exclude './packages/mailwoman/gazetteer-pipeline/evidence-lexicons.full.test.ts' --exclude './packages/mailwoman/commands/geocode.test.ts' --exclude './packages/mailwoman/debug-view/static.test.ts' --exclude './packages/resolver-wof-sqlite/**' --exclude './packages/neural/test/**'",
		"ci:test:slow": "vitest --run packages/mailwoman/test packages/mailwoman/commands/geocode.test.ts packages/mailwoman/debug-view/ packages/resolver-wof-sqlite packages/neural/test",
		"ci:test:lexicon-full": "vitest --run packages/mailwoman/gazetteer-pipeline/evidence-lexicons.full.test.ts",
		"ci:tile-worker": "run-s compile",
		"compile": "NODE_OPTIONS=\"--max-old-space-size=3000\" tsc -b",
		"compile:clean": "tsc -b --clean",
		"docs:build": "yarn workspace @mailwoman/docs build",
		"fix:oxlint": "oxlint --fix",
		"fix:python": "uvx ruff@0.15.20 check --fix corpus-python && uvx ruff@0.15.20 format corpus-python",
		"format": "oxfmt .",
		"lint": "run-s lint:oxlint lint:oxfmt lint:python",
		"lint:fix": "run-s fix:oxlint format fix:python",
		"lint:oxfmt": "oxfmt --check .",
		"lint:oxlint": "oxlint",
		"lint:python": "uvx ruff@0.15.20 check corpus-python && uvx ruff@0.15.20 format --check corpus-python && python3 corpus-python/scripts/verify_toolchain.py",
		"prepare": "husky",
		"release": "release-it",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"test:integration": "vitest --dir ./packages/mailwoman/test",
		"test:unit": "vitest --exclude ./packages/mailwoman/test",
		"typecheck": "run-s compile typecheck:tests typecheck:docs",
		"typecheck:docs": "tsc -p docs/tsconfig.json --noEmit",
		"typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
		"typecheck:tests": "node scripts/typecheck-tests.ts"
	},
	"devDependencies": {
		"@duckdb/node-api": "^1.5.3-r.3",
		"@inkjs/ui": "^2.0.0",
		"@release-it-plugins/workspaces": "^6.0.0",
		"@sister.software/oxfmt-config": "^12.1.3",
		"@sister.software/oxlint-config": "^12.1.3",
		"@sister.software/tsconfig": "^12.1.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.1.2",
		"@types/pluralize": "^0.0.33",
		"@types/react": "^19.2.17",
		"@types/regenerate": "^1.4.3",
		"@types/semver": "^7.7.1",
		"chalk": "^6.0.0",
		"fast-glob": "^3.3.3",
		"husky": "^9.1.7",
		"ink": "^7.1.1",
		"npm-run-all": "^4.1.5",
		"oxfmt": "0.61.0",
		"oxlint": "1.76.0",
		"react": "^19.2.8",
		"release-it": "^19.2.4",
		"semver": "^7.8.5",
		"spliterator": "^6.1.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.10",
		"zx": "^8.8.5"
	},
	"resolutions": {
		"http-proxy-middleware@^2.0.9": "2.0.10",
		"serialize-javascript": "^7.0.5",
		"sockjs/uuid": "^11.1.1",
		"undici": "^6.24.0",
		"websocket-driver": "^0.7.5"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"packageManager": "yarn@4.17.0"
}
