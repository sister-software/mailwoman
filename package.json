{
	"name": "@mailwoman/universe",
	"version": "10.7.0",
	"private": true,
	"description": "Mailwoman monorepo workspace root.",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"contributors": [
		{
			"name": "Teffen Ellis",
			"email": "teffen@sister.software"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/sister-software/mailwoman.git"
	},
	"bin": {
		"mwbrowser-mcp": "./lib/browser-mcp/cli.ts",
		"mwdev-mcp": "./lib/dev-mcp/cli.ts",
		"mwrelease-mcp": "./lib/release-mcp/cli.ts"
	},
	"workspaces": [
		"docs",
		"packages/*"
	],
	"type": "module",
	"imports": {
		"#config/*": "./config/*.ts",
		"#release-kit": "./lib/release-kit/index.ts",
		"#release-mcp": "./lib/release-mcp/index.ts",
		"#ops-cli": "./lib/ops-cli/index.ts",
		"#repo-health": "./lib/repo-health/index.ts",
		"#storage-kit": "./lib/storage-kit/index.ts",
		"#*": "./lib/*.ts"
	},
	"exports": {
		"./package.json": "./package.json",
		"./.release-it.json": "./.release-it.json",
		"./release-it.json": "./.release-it.json",
		"./config/*.json": "./config.json",
		"./config/*": "./config.ts",
		"./site-kit/*": "./lib/site-kit/*.ts",
		"./release-kit": "./lib/release-kit/index.ts",
		"./release-kit/operation": "./lib/release-kit/operation.ts",
		"./release-mcp": "./lib/release-mcp/index.ts",
		"./ops-cli": "./lib/ops-cli/index.ts",
		"./repo-health": "./lib/repo-health/index.ts",
		"./storage-kit": "./lib/storage-kit/index.ts"
	},
	"scripts": {
		"ci:docs": "run-s compile docs:build",
		"ci:smoke": "yarn mwops release smoke-clean-install",
		"ci:test": "vitest --run",
		"ci:test:fast": "vitest --run --config vitest.fast.config.ts",
		"ci:test:lexicon-full": "vitest --run --config vitest.full.config.ts",
		"ci:test:pair-index-parity": "vitest --run pair/index-card-parity",
		"ci:test:slow": "vitest --run --config vitest.slow.config.ts",
		"ci:workers": "NODE_OPTIONS=\"--max-old-space-size=3000\" tsc -b packages/license-worker packages/tile-worker",
		"compile": "NODE_OPTIONS=\"--max-old-space-size=3000\" tsc -b",
		"clean": "yarn mwops release clean",
		"comments:joints": "node config/oxlint/comment-reflow/joint-sweep.ts",
		"comments:sweep": "node config/oxlint/comment-reflow/dash-sweep.ts",
		"comments:triage": "yarn mwops health comments",
		"docs:build": "yarn workspace @mailwoman/docs build",
		"fix:oxc": "node config/oxlint/fix-changed.ts",
		"fix:oxc:all": "node config/oxlint/fix-changed.ts --all",
		"format": "oxfmt .",
		"health": "run-p --aggregate-output --print-label --continue-on-error health:debt health:architecture health:manifests health:exports health:test-layout health:bundles health:duplicates health:reexports",
		"health:architecture": "depcruise packages --config dependency-cruiser.config.mjs",
		"health:bundles": "yarn mwops health bundle-graph",
		"health:debt": "yarn mwops health debt",
		"health:debt:update": "yarn mwops health baseline debt",
		"health:duplicates": "jscpd --config jscpd.json",
		"health:exports": "yarn mwops health exports",
		"health:manifests": "sherif -i @duckdb/node-api -i @types/node -i typescript -i vitest",
		"health:reexports": "yarn mwops health module-reexports",
		"health:test-layout": "yarn mwops health test-layout",
		"lint": "run-p --aggregate-output --print-label --continue-on-error lint:oxlint lint:oxfmt lint:prose lint:spelling health",
		"lint:ci": "run-p --aggregate-output --print-label --continue-on-error lint:oxlint lint:oxfmt lint:prose lint:spelling health",
		"lint:fix": "run-p --aggregate-output --print-label --continue-on-error fix:oxc",
		"lint:fix:all": "run-p --aggregate-output --print-label --continue-on-error fix:oxc:all",
		"lint:oxfmt": "oxfmt --check .",
		"lint:oxlint": "oxlint",
		"lint:spelling": "typos .",
		"lint:spelling:fix": "typos --write-changes .",
		"lint:prose": "run-p --aggregate-output --print-label --continue-on-error lint:prose:vocab lint:prose:code",
		"lint:prose:code": "node config/vale/lint-prose.ts -s code",
		"lint:prose:vocab": "yarn workspace @mailwoman/docs lint:prose:vocab",
		"mwops": "node lib/ops-cli/cli.ts",
		"prepare": "husky",
		"release": "release-it",
		"release:preflight": "yarn mwops release preflight",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"test:integration": "vitest --config vitest.slow.config.ts",
		"test:license-worker": "yarn workspace @mailwoman/license-worker test",
		"test:unit": "vitest --config vitest.fast.config.ts",
		"typecheck": "run-s compile typecheck:projects",
		"typecheck:docs": "tsc -p docs/tsconfig.json --noEmit",
		"typecheck:projects": "run-p --aggregate-output --print-label --continue-on-error typecheck:tests typecheck:docs typecheck:tools",
		"typecheck:tests": "yarn mwops health typecheck-tests",
		"typecheck:tools": "tsc -p tsconfig.tools.json"
	},
	"devDependencies": {
		"@duckdb/node-api": "^1.5.6-r.1",
		"@mailwoman/browser": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/corpus": "workspace:*",
		"@mailwoman/geocode-oracle": "workspace:*",
		"@mailwoman/libpostal": "workspace:*",
		"@mailwoman/license-worker": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/normalize": "workspace:*",
		"@mailwoman/postcode": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@ocular-d/typos-bin": "^1.51.1",
		"@oxlint/plugins": "1.88.0",
		"@playwright/test": "^1.64.1",
		"@release-it-plugins/workspaces": "^6.0.0",
		"@sister.software/oxfmt-config": "^14.0.0",
		"@sister.software/oxlint-config": "^14.0.0",
		"@sister.software/tsconfig": "^14.0.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/regenerate": "^1.4.3",
		"@types/semver": "^7.8.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "5.0.5",
		"@vvago/vale": "^3.24.0",
		"dependency-cruiser": "^18.6.0",
		"esbuild": "0.28.2",
		"husky": "^9.1.7",
		"jscpd": "^5.4.1",
		"knip": "^6.41.0",
		"mailwoman": "workspace:*",
		"npm-run-all": "^4.1.5",
		"onnxruntime-web": "1.30.0",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"path-ts": "^2.5.0",
		"release-it": "^19.2.4",
		"semver": "^7.8.5",
		"sherif": "^1.13.0",
		"spliterator": "^10.1.1",
		"ts-morph": "^28.0.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "5.0.5",
		"zod": "^4.6.7"
	},
	"resolutions": {
		"@docusaurus/core/tinypool": "2.2.0",
		"@playwright/mcp/playwright": "1.64.1",
		"@playwright/mcp/playwright-core": "1.64.1",
		"http-proxy-middleware@^2.0.9": "2.0.10",
		"mermaid/katex": "^0.18.2",
		"miniflare/sharp": "0.35.5",
		"query-string/decode-uri-component": "^0.5.0",
		"serialize-javascript": "^7.0.5",
		"sockjs/uuid": "^11.1.1",
		"undici": "^6.24.0",
		"websocket-driver": "^0.7.5",
		"zod@^4.5.4": "4.5.4"
	},
	"engines": {
		"node": "^24.22.1 || >=26.12.1"
	},
	"packageManager": "yarn@4.18.1"
}
