#!/usr/bin/env sh

# Pre-commit policy (lint-only, staged-scoped):
# - Tests run in CI, not here.
# - Repo-wide lint runs in CI (`yarn lint`), not here.
# - This hook checks only staged paths, so unrelated/untracked WIP won't block commits.
#
# Important caveat:
# - Linters read WORKING-TREE content for staged paths.
# - If a file is partially staged, linting sees current worktree state.

set -e

# Build staged-file list:
# - ACMR only (Added/Copied/Modified/Renamed).
# - Skip deletions (nothing to lint).
# - Keep only files that still exist in worktree (prevents crashes).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
	[ -f "$f" ] && printf '%s\n' "$f"
done)

# CLI freshness setup (computed BEFORE formatting):
# - `oxfmt --write` can bump mtime even when file bytes do not change.
# - So the `-newer` freshness check must use timestamps captured before formatter runs,
#   otherwise command-file commits can fail forever until timing changes.
CLI_REF=packages/mailwoman/tsconfig.tsbuildinfo
[ -f "$CLI_REF" ] || CLI_REF=packages/mailwoman/out/tsconfig.tsbuildinfo
[ -f "$CLI_REF" ] || CLI_REF=packages/mailwoman/out/cli/main.js
CLI_STALE_SRC=""
if [ -f "$CLI_REF" ]; then
	# Source-of-truth paths that can stale generated CLI docs/man output:
	# - cli/commands
	# - cli/kit
	# - cli/native
	#
	# Exclude test files:
	# - Compile excludes `*.test.ts`/`*.test.tsx`.
	# - Including tests here would create false stale failures (compile can never "refresh" them).
	CLI_STALE_SRC=$(find packages/mailwoman/cli/commands packages/mailwoman/cli/kit packages/mailwoman/cli/native \( -name '*.tsx' -o -name '*.ts' \) ! -name '*.test.ts' ! -name '*.test.tsx' -newer "$CLI_REF" -print -quit 2>/dev/null)
fi

if [ -n "$STAGED" ]; then
	# JS/TS lint:
	# - oxlint errors on unsupported paths, so pass only code extensions.
	# - Config/rules still apply when explicit paths are passed.
	CODE=$(printf '%s\n' "$STAGED" | grep -E '\.(ts|tsx|mts|cts|js|mjs|cjs|jsx)$' || true)
	if [ -n "$CODE" ]; then
		printf '%s\n' "$CODE" | tr '\n' '\0' | xargs -0 yarn oxlint --fix
	fi

	# Formatter:
	# - oxfmt has no `--check`; it writes fixes.
	# - It errors if no input path is a supported format target.
	# - So pass only known format extensions.
	FMT=$(printf '%s\n' "$STAGED" | grep -E '\.(ts|tsx|mts|cts|js|mjs|cjs|jsx|json|jsonc|md|mdx|toml|css|html)$' || true)
	if [ -n "$FMT" ]; then
		FMT_OUT=$(printf '%s\n' "$FMT" | tr '\n' '\0' | xargs -0 yarn oxfmt --write 2>&1) || {
			if printf '%s' "$FMT_OUT" | grep -q "may have been excluded by ignore rules"; then
				echo "pre-commit: all staged format targets are oxfmt-excluded — skipping format"
			else
				exit 1
			fi
		}
	fi

	# Python checks:
	# - Run ruff check+format on staged `corpus-python/**/*.py`.
	# - Run toolchain pin-consistency check when:
	#   - anything under `corpus-python/` is staged, or
	#   - `pyproject.toml` or `uv.lock` is staged.
	PY=$(printf '%s\n' "$STAGED" | grep -E '^corpus-python/.*\.py$' || true)
	if [ -n "$PY" ]; then
		printf '%s\n' "$PY" | tr '\n' '\0' | xargs -0 uv run --extra dev ruff check --fix
		printf '%s\n' "$PY" | tr '\n' '\0' | xargs -0 uv run --extra dev ruff format
	fi
	if printf '%s\n' "$STAGED" | grep -qE '^corpus-python/|^pyproject\.toml$|^uv\.lock$'; then
		uv run --extra dev --extra train python corpus-python/scripts/verify_toolchain.py
	fi

	# Re-stage any files modified by auto-fixers.
	printf '%s\n' "$STAGED" | tr '\n' '\0' | xargs -0 git add

	# Prose lint (Vale), staged-scoped.
	node config/vale/lint-prose.ts --staged -s docs-vocab -s code
fi

# CLI reference + man-page drift prevention:
# - Only runs when staged changes touch `packages/mailwoman/cli/(commands|kit|native)/`.
# - Generator reads COMPILED output (`out/cli/...`), not TSX source directly.
# - Therefore, stale compile output can generate wrong bytes.
# - Freshness guard converts that into a clear "run compile" instruction.
if git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^packages/mailwoman/cli/(commands|kit|native)/'; then
	if [ -f packages/mailwoman/out/cli/main.js ]; then
		# Why buildinfo is the preferred freshness reference:
		# - `tsc -b` may leave `cli.js` untouched when bytes are identical.
		# - But `tsbuildinfo` is touched on each build run.
		# - So buildinfo avoids "permanent stale" false failures.
		# - Fallback to `cli.js` only when buildinfo is unavailable.
		# - Comparison source is precomputed at script start (`CLI_STALE_SRC`) before formatter mtimes shift.
		if [ -n "$CLI_STALE_SRC" ]; then
			echo "pre-commit: $CLI_STALE_SRC is newer than the compiled CLI — run 'yarn compile' so the CLI reference regenerates from what you actually changed" >&2
			exit 1
		fi
		node docs/scripts/generate-cli-reference.ts
		if ! git diff --quiet -- docs/articles/developers/reference/cli.mdx; then
			echo "pre-commit: the CLI reference moved — it has been regenerated in your worktree; stage it and retry:" >&2
			echo "  git add docs/articles/developers/reference/cli.mdx" >&2
			exit 1
		fi
		# Also enforce man-page freshness with same remediation pattern.
		node packages/mailwoman/out/cli/main.js dev generate man-page
		if ! git diff --quiet -- packages/mailwoman/man/mailwoman.1; then
			echo "pre-commit: the man page moved — it has been regenerated in your worktree; stage it and retry:" >&2
			echo "  git add packages/mailwoman/man/mailwoman.1" >&2
			exit 1
		fi
	else
		echo "pre-commit: packages/mailwoman/out/cli/main.js not compiled — skipping CLI-reference freshness (CI's byte-for-byte test still checks)" >&2
	fi
fi

# MDX raw-angle lint:
# - Catches build-breaking MDX/JSX parse cases like bare `<55` in prose.
# - Runs through compiled CLI tooling, so it requires `yarn compile` output.
# - If not compiled, warn and skip locally; CI full lint still enforces it.
if [ -f packages/mailwoman/out/cli/main.js ]; then
	node packages/mailwoman/out/cli/main.js dev lint mdx-angles
else
	echo "pre-commit: packages/mailwoman/out/cli/main.js not compiled — skipping mdx-angles lint (run 'yarn compile')" >&2
fi
