#!/usr/bin/env sh

# Lint-only, STAGED-SCOPED pre-commit (2026-07-08): tests are CI's job, and repo-wide lint is CI's
# job too (the Test workflow's Lint step runs the full `yarn lint`). The hook checks only what this
# commit stages, so untracked WIP and unrelated drift can't block a commit.
#
# Caveat: the linters read the WORKING-TREE contents of staged paths — a partially-staged file is
# checked at its worktree state (same trade-off as lint-staged without the stash dance).
#
# set -e: without it a failing step never blocked the commit (the hook's exit code was the LAST
# command's) — the old lint+tests hook had this hole.
set -e

# Added/Copied/Modified/Renamed only — deletions have nothing to lint. Existence-filtered so a path
# staged and then removed from the worktree can't crash the linters.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
	[ -f "$f" ] && printf '%s\n' "$f"
done)

if [ -n "$STAGED" ]; then
	# oxlint errors on paths it can't lint, so scope it to code files. Config discovery
	# (oxlint.config.ts, incl. the sister-software/no-process-globals raw-access gate) is
	# path-independent — verified: explicit paths keep every rule active.
	CODE=$(printf '%s\n' "$STAGED" | grep -E '\.(ts|tsx|mts|cts|js|mjs|cjs|jsx)$' || true)
	if [ -n "$CODE" ]; then
		printf '%s\n' "$CODE" | tr '\n' '\0' | xargs -0 yarn oxlint --fix
	fi

	# oxfmt auto-formats (no --check flag). Errors when NO path in the list is a target (e.g. a
	# commit staging only .yml/.sh), so scope it to the types it formats.
	FMT=$(printf '%s\n' "$STAGED" | grep -E '\.(ts|tsx|mts|cts|js|mjs|cjs|jsx|json|jsonc|md|mdx|toml|css|html)$' || true)
	if [ -n "$FMT" ]; then
		FMT_OUT=$(printf '%s\n' "$FMT" | tr '\n' '\0' | xargs -0 yarn oxfmt --write 2>&1) || {
			if printf '%s' "$FMT_OUT" | grep -q "may have been excluded by ignore rules"; then
				echo "pre-commit: all staged format targets are oxfmt-excluded — skipping format"
			else
				exit 1
			fi
		}
	fi

	# Python: ruff on staged corpus-python sources; the pin-consistency check runs whenever
	# ANYTHING under corpus-python/ is staged (pyproject/modal edits must keep agreeing).
	PY=$(printf '%s\n' "$STAGED" | grep -E '^corpus-python/.*\.py$' || true)
	if [ -n "$PY" ]; then
		printf '%s\n' "$PY" | tr '\n' '\0' | xargs -0 uvx ruff@0.15.20 check --fix
		printf '%s\n' "$PY" | tr '\n' '\0' | xargs -0 uvx ruff@0.15.20 format
	fi
	if printf '%s\n' "$STAGED" | grep -q '^corpus-python/'; then
		python3 corpus-python/scripts/verify_toolchain.py
	fi

	# Re-stage fixed files so they're included in the commit
	printf '%s\n' "$STAGED" | tr '\n' '\0' | xargs -0 git add
fi

# CLI-reference freshness (2026-08-05): the docs CI gate asserts docs/articles/developers/reference/
# cli.mdx byte-for-byte against the command schemas, and it fired four times in one day because the
# regeneration step lives a 20-minute CI round-trip away. Staged-scoped: only runs when this commit
# touches the command surface. The generator reads the COMPILED tree (packages/mailwoman/out/commands — the
# commands are TSX, which node cannot type-strip), so a stale out/ would silently regenerate WRONG
# bytes; the mtime guard turns that into an instruction instead.
if git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^packages/mailwoman/lib/(commands|cli-kit)/'; then
	if [ -f packages/mailwoman/out/cli.js ]; then
		# Freshness reference: the tsbuildinfo, not cli.js — an incremental `tsc -b` that finds
		# cli.js byte-identical does not rewrite it, so an mtime check against cli.js blocks
		# forever after an unrelated source edit (bit the ablation-harness worktree 2026-08-05).
		# tsc always touches the buildinfo when it runs; fall back to cli.js on trees without one.
		# tsc writes the buildinfo NEXT TO THE TSCONFIG, not into outDir — `packages/mailwoman/tsconfig.tsbuildinfo`.
		# This named `out/tsconfig.tsbuildinfo`, which has not existed for some time, so the guard silently fell
		# through to the cli.js branch below and lost the property it was reaching for: tsc touches the buildinfo
		# on every run, including one that finds every output byte-identical, whereas cli.js is only rewritten
		# when its bytes change. A formatter that rewrites a source without changing it then trips the guard
		# forever, and `yarn compile` cannot clear it because there is nothing to rebuild.
		REF=packages/mailwoman/tsconfig.tsbuildinfo
		[ -f "$REF" ] || REF=packages/mailwoman/out/tsconfig.tsbuildinfo
		[ -f "$REF" ] || REF=packages/mailwoman/out/cli.js
		NEWEST_SRC=$(find packages/mailwoman/lib/commands packages/mailwoman/lib/cli-kit \( -name '*.tsx' -o -name '*.ts' \) -newer "$REF" -print -quit 2>/dev/null)
		if [ -n "$NEWEST_SRC" ]; then
			echo "pre-commit: $NEWEST_SRC is newer than the compiled CLI — run 'yarn compile' so the CLI reference regenerates from what you actually changed" >&2
			exit 1
		fi
		node docs/scripts/generate-cli-reference.ts
		if ! git diff --quiet -- docs/articles/developers/reference/cli.mdx; then
			echo "pre-commit: the CLI reference moved — it has been regenerated in your worktree; stage it and retry:" >&2
			echo "  git add docs/articles/developers/reference/cli.mdx" >&2
			exit 1
		fi
		# The SECOND generated artifact, same freshness contract: the man page's CI drift test fired on
		# 2026-08-17 (cli.mdx prose) and again on 2026-08-18 (a new flag) because only cli.mdx was
		# hook-covered. Same guard, same remediation shape.
		node scripts/generate-man.ts
		if ! git diff --quiet -- packages/mailwoman/man/mailwoman.1; then
			echo "pre-commit: the man page moved — it has been regenerated in your worktree; stage it and retry:" >&2
			echo "  git add packages/mailwoman/man/mailwoman.1" >&2
			exit 1
		fi
	else
		echo "pre-commit: packages/mailwoman/out/cli.js not compiled — skipping CLI-reference freshness (CI's byte-for-byte test still gates)" >&2
	fi
fi

# Raw-angle MDX lint — already staged-scoped by default (see the script header). A bare `<55` in
# docs prose is a build-breaking MDX-JSX parse error; this class broke three builds on 2026-06-10.
# The lint tool lives at mailwoman/dev-tools/lint-mdx-angles.ts
# and needs the compiled CLI (`yarn compile`). An uncompiled tree (fresh clone) skips with a warning
# rather than blocking every commit — CI's full lint still gates this class.
if [ -f packages/mailwoman/out/cli.js ]; then
	node packages/mailwoman/out/cli.js dev lint mdx-angles
else
	echo "pre-commit: packages/mailwoman/out/cli.js not compiled — skipping mdx-angles lint (run 'yarn compile')" >&2
fi
