{
	"outputStyle": "Mailwoman Development",
	"worktree": {
		"symlinkDirectories": ["node_modules"]
	},
	"permissions": {
		"deny": ["Read(./data/coarse-placer/**/*.jsonl)", "Read(./data/eval/**/*.jsonl)"]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/lib/dev-mcp/hooks/symbol-precheck.ts\"",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/lib/dev-mcp/hooks/bash/write/guard.ts\"",
						"timeout": 10,
						"statusMessage": "Bash write guard"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "TodoWrite",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/lib/dev-mcp/hooks/todo-issue-sync.ts\"",
						"timeout": 15
					}
				]
			},
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/lib/dev-mcp/hooks/vale/edit/check.ts\"",
						"timeout": 30,
						"statusMessage": "Prose check"
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/lib/dev-mcp/hooks/session-orientation.ts\"",
						"timeout": 15,
						"statusMessage": "Workspace orientation"
					},
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/lib/dev-mcp/hooks/vale/session/digest.ts\"",
						"timeout": 15,
						"statusMessage": "Prose rules"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/lib/dev-mcp/hooks/ci-completion.ts\"",
						"timeout": 30,
						"statusMessage": "CI completion check"
					},
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/lib/dev-mcp/hooks/vale/response/check.ts\"",
						"timeout": 30,
						"statusMessage": "Vale prose check"
					}
				]
			}
		]
	}
}
