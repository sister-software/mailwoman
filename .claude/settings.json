{
	"outputStyle": "Mailwoman Development",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/packages/dev-mcp/hooks/symbol-precheck.ts\"",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "TodoWrite",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/packages/dev-mcp/hooks/todo-issue-sync.ts\"",
						"timeout": 15
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/packages/dev-mcp/hooks/vale-response-check.ts\"",
						"timeout": 30,
						"statusMessage": "Vale prose check"
					}
				]
			}
		]
	}
}
