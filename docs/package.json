{
	"name": "@mailwoman/docs",
	"version": "0.0.0",
	"private": true,
	"description": "Docusaurus knowledge base for Mailwoman Geocoder",
	"imports": {
		"#docs-sub-header": "./src/components/DocsSubHeader/index.tsx",
		"#e2e": "./test/e2e/index.ts",
		"#e2e/*": "./test/e2e/*",
		"#glossary-plugin": "./plugins/glossary/plugin.ts",
		"#components/*": "./src/components/*.tsx",
		"#contexts/*": "./src/contexts/*.tsx",
		"#hooks/*": "./src/hooks/*.ts",
		"#shared/resources": "./src/shared/resources/index.ts",
		"#shared/*": "./src/shared/*.ts"
	},
	"exports": {
		"./package.json": "./package.json",
		"./components/*": "./src/components/*.tsx",
		"./contexts/*": "./src/contexts/*.tsx",
		"./hooks/*": "./src/hooks/*.ts",
		"./shared/resources": "./src/shared/resources/index.ts",
		"./shared/*": "./src/shared/*.ts",
		"./components/ModelVisualizer/fixtures/white-house.trace.json": "./src/components/ModelVisualizer/fixtures/white-house.trace.json",
		"./components/ModelVisualizer/helpers": "./src/components/ModelVisualizer/helpers.ts",
		"./pages/demo/map-helpers": "./src/pages/demo/_map-helpers.ts",
		"./plugins/demo-assets/webpack-policy": {
			"node": "./plugins/demo-assets/webpack-policy.ts",
			"default": "./plugins/demo-assets/webpack-policy.ts",
			"types": "./plugins/demo-assets/webpack-policy.ts"
		},
		"./plugins/demo-assets/workspace-aliases": {
			"node": "./plugins/demo-assets/workspace-aliases.ts",
			"default": "./plugins/demo-assets/workspace-aliases.ts",
			"types": "./plugins/demo-assets/workspace-aliases.ts"
		},
		"./scripts/docs-frontmatter-contract": {
			"node": "./scripts/docs-frontmatter-contract.ts",
			"default": "./scripts/docs-frontmatter-contract.ts",
			"types": "./scripts/docs-frontmatter-contract.ts"
		},
		"./scripts/generate-cli-reference": {
			"node": "./scripts/generate-cli-reference.ts",
			"default": "./scripts/generate-cli-reference.ts",
			"types": "./scripts/generate-cli-reference.ts"
		}
	},
	"scripts": {
		"build": "yarn prebuild && docusaurus build",
		"build-storybook": "storybook build",
		"clear": "docusaurus clear",
		"docusaurus": "docusaurus",
		"freshness-report": "node scripts/list-stale-docs.ts",
		"lint:prose": "vale --config .vale.ini articles src/pages engineering/writing-system.md engineering/page-templates",
		"lint:prose:fixtures": "node scripts/check-vale-rules.ts",
		"lint:prose:vocab": "vale --config .vale-vocab.ini ../AGENTS.md ../README.md ../RELEASING.md ../CONTRIBUTING.md ../REPRODUCIBILITY.md ../.claude/output-styles/mailwoman-development.md engineering/*.md engineering/*.mdx engineering/reference && vale --config .vale-vocab.ini --glob='*README.md' ../packages",
		"lint:structure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs-structure.ts --strict",
		"prebuild": "node ../packages/mailwoman/out/cli.js openapi --out ./static/openapi/mailwoman.json && node ../packages/libpostal/out/cli.js openapi --out ./static/openapi/libpostal.json && node ../packages/photon/out/cli.js openapi --out ./static/openapi/photon.json && node ../packages/nominatim/out/cli.js openapi --out ./static/openapi/nominatim.json && node ./scripts/generate-cli-reference.ts",
		"serve": "docusaurus serve --host 0.0.0.0 --port 7770",
		"start": "docusaurus start --host 0.0.0.0 --port 7770 --no-open",
		"storybook": "storybook dev -p 6006 --no-open",
		"swizzle": "docusaurus swizzle",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"typecheck": "tsc",
		"write-heading-ids": "docusaurus write-heading-ids",
		"write-translations": "docusaurus write-translations"
	},
	"dependencies": {
		"@docusaurus/core": "^3.10.2",
		"@docusaurus/faster": "^3.10.2",
		"@docusaurus/plugin-content-docs": "^3.10.2",
		"@docusaurus/preset-classic": "^3.10.2",
		"@docusaurus/theme-common": "^3.10.2",
		"@docusaurus/theme-mermaid": "^3.10.2",
		"@mailwoman/cartographer": "workspace:*",
		"@mailwoman/codex": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/kind-classifier": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/phrase-grouper": "workspace:*",
		"@mailwoman/query-shape": "workspace:*",
		"@mailwoman/react": "workspace:^",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mdx-js/react": "^3.1.1",
		"classnames": "^2.5.1",
		"clsx": "^2.1.1",
		"docusaurus-plugin-glossary": "^3.3.4",
		"h3-js": "^4.5.0",
		"js-yaml": "^5.3.0",
		"maplibre-gl": "^6.5.0",
		"onnxruntime-web": "1.25.0-dev.20260327-722743c0e2",
		"path-ts": "^2.1.0",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-map-gl": "^8.1.2",
		"webpack": "^5.102.1"
	},
	"devDependencies": {
		"@docusaurus/module-type-aliases": "^3.10.2",
		"@docusaurus/types": "^3.10.2",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-docs": "^10.5.5",
		"@storybook/react-vite": "^10.5.5",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-map-gl": "^6.1.8",
		"@vitejs/plugin-react": "^6.0.5",
		"@vvago/vale": "^3.17.0",
		"spliterator": "^6.2.0",
		"sql.js-httpvfs": "^0.8.12",
		"storybook": "^10.5.5",
		"typescript": "^6.0.3",
		"unist": "^0.0.1",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.2.0",
		"zx": "^8.8.5"
	},
	"browserslist": {
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	},
	"engines": {
		"node": ">=24.0"
	}
}
