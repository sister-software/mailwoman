{
	"name": "@mailwoman/docs",
	"version": "0.0.0",
	"private": true,
	"description": "Docusaurus knowledge base for Mailwoman Geocoder",
	"imports": {
		"#docs-sub-header": "./src/components/DocsSubHeader/index.tsx",
		"#unit/*": "./test/unit/*.ts",
		"#glossary-plugin": "./plugins/glossary/plugin.ts",
		"#components/*": "./src/components/*.tsx",
		"#contexts/*": "./src/contexts/*.tsx",
		"#hooks/*": "./src/hooks/*.ts",
		"#shared/*": "./src/shared/*.ts"
	},
	"exports": {
		"./package.json": "./package.json",
		"./components/*": "./src/components/*.tsx",
		"./contexts/*": "./src/contexts/*.tsx",
		"./hooks/*": "./src/hooks/*.ts",
		"./shared/*": "./src/shared/*.ts",
		"./plugins/runtime-assets/artifacts": {
			"types": "./plugins/runtime-assets/artifacts.ts",
			"node": "./plugins/runtime-assets/artifacts.ts",
			"default": "./plugins/runtime-assets/artifacts.ts"
		},
		"./plugins/runtime-assets/webpack-policy": {
			"types": "./plugins/runtime-assets/webpack-policy.ts",
			"node": "./plugins/runtime-assets/webpack-policy.ts",
			"default": "./plugins/runtime-assets/webpack-policy.ts"
		},
		"./plugins/runtime-assets/workspace-aliases": {
			"types": "./plugins/runtime-assets/workspace/aliases.ts",
			"node": "./plugins/runtime-assets/workspace/aliases.ts",
			"default": "./plugins/runtime-assets/workspace/aliases.ts"
		},
		"./scripts/docs-frontmatter-contract": {
			"types": "./scripts/docs/frontmatter/contract.ts",
			"node": "./scripts/docs/frontmatter/contract.ts",
			"default": "./scripts/docs/frontmatter/contract.ts"
		},
		"./scripts/docs-path-citations": {
			"types": "./scripts/docs/path-citations.ts",
			"node": "./scripts/docs/path-citations.ts",
			"default": "./scripts/docs/path-citations.ts"
		},
		"./scripts/generate-cli-reference": {
			"types": "./scripts/generate-cli-reference.ts",
			"node": "./scripts/generate-cli-reference.ts",
			"default": "./scripts/generate-cli-reference.ts"
		}
	},
	"scripts": {
		"build": "yarn prebuild && docusaurus build",
		"build-storybook": "storybook build",
		"clear": "docusaurus clear",
		"docusaurus": "docusaurus",
		"freshness-report": "node scripts/list-stale-docs.ts",
		"lint:prose": "node ../config/vale/lint-prose.ts docs",
		"lint:prose:fixtures": "node ../config/vale/check-rules.ts",
		"lint:prose:vocab": "node ../config/vale/lint-prose.ts docs-vocab",
		"lint:structure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check/docs-structure.ts --strict",
		"prebuild": "node ../packages/mailwoman/out/cli/index.js openapi --out ./static/openapi/mailwoman.json && node ../packages/libpostal/out/cli.js openapi --out ./static/openapi/libpostal.json && node ../packages/photon/out/cli.js openapi --out ./static/openapi/photon.json && node ../packages/nominatim/out/cli.js openapi --out ./static/openapi/nominatim.json && node ./scripts/generate-cli-reference.ts",
		"serve": "docusaurus serve --host 0.0.0.0 --port 7770",
		"start": "docusaurus start --host 0.0.0.0 --port 7770 --no-open",
		"storybook": "storybook dev -p 6006 --no-open",
		"swizzle": "docusaurus swizzle",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"typecheck": "tsc",
		"write-heading-ids": "docusaurus write-heading-ids",
		"write-translations": "docusaurus write-translations"
	},
	"dependencies": {
		"@docusaurus/core": "^3.10.2",
		"@docusaurus/faster": "^3.10.2",
		"@docusaurus/plugin-client-redirects": "^3.10.2",
		"@docusaurus/plugin-content-docs": "^3.10.2",
		"@docusaurus/preset-classic": "^3.10.2",
		"@docusaurus/theme-common": "^3.10.2",
		"@docusaurus/theme-mermaid": "^3.10.2",
		"@mailwoman/cartographer": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/license-worker": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/react": "workspace:^",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mdx-js/react": "^3.1.1",
		"clsx": "^2.1.1",
		"docusaurus-plugin-glossary": "^3.3.4",
		"js-yaml": "^5.4.2",
		"mailwoman": "workspace:*",
		"maplibre-gl": "^6.7.0",
		"onnxruntime-web": "1.29.0",
		"path-ts": "^2.4.1",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-map-gl": "^8.1.3",
		"webpack": "^5.110.3"
	},
	"devDependencies": {
		"@docusaurus/module-type-aliases": "^3.10.2",
		"@docusaurus/types": "^3.10.2",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/react-map-gl": "^6.1.10",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.1.1",
		"spliterator": "^7.11.0",
		"storybook": "^10.6.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"unist": "^0.0.1",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.2.2"
	},
	"browserslist": {
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	},
	"engines": {
		"node": ">=24.0"
	}
}
