{
	"name": "@mailwoman/docs",
	"version": "0.0.0",
	"private": true,
	"description": "Docusaurus knowledge base for Mailwoman Geocoder",
	"license": "AGPL-3.0-only OR LicenseRef-Commercial",
	"imports": {
		"#glossary-plugin": "./plugins/glossary/plugin.ts",
		"#components/*": "./src/components/*.tsx",
		"#contexts/*": "./src/contexts/*.tsx",
		"#hooks/*": "./src/hooks/*.ts",
		"#shared/*": "./src/shared/*.ts"
	},
	"exports": {
		"./package.json": "./package.json",
		"./components/*": "./src/components/*.tsx",
		"./contexts/*": "./src/contexts/*.tsx",
		"./hooks/*": "./src/hooks/*.ts",
		"./shared/*": "./src/shared/*.ts",
		"./plugins/*": {
			"types": "./plugins/*.ts",
			"node": "./plugins/*.ts",
			"default": "./plugins/*.ts"
		},
		"./scripts/*": {
			"types": "./scripts/*.mts",
			"node": "./scripts/*.mts",
			"default": "./scripts/*.mts"
		}
	},
	"scripts": {
		"build": "yarn prebuild && docusaurus build",
		"build-storybook": "storybook build",
		"clear": "docusaurus clear",
		"docusaurus": "docusaurus",
		"freshness-report": "node scripts/list-stale-docs.mts",
		"lint:prose": "node ../config/vale/lint-prose.ts -s docs",
		"lint:prose:fixtures": "node ../config/vale/check-rules.ts",
		"lint:prose:vocab": "node ../config/vale/lint-prose.ts -s docs-vocab",
		"lint:structure": "node scripts/check/docs-structure.mts",
		"prebuild": "node ../packages/mailwoman/out/cli/main.js openapi --out ./static/openapi/mailwoman.json && node ../packages/libpostal/out/cli/main.js openapi --out ./static/openapi/libpostal.json && node ../packages/photon/out/cli/main.js openapi --out ./static/openapi/photon.json && node ../packages/nominatim/out/cli/main.js openapi --out ./static/openapi/nominatim.json && node ./scripts/generate-cli-reference.mts",
		"serve": "docusaurus serve --host 0.0.0.0 --port 7770",
		"start": "docusaurus start --host 0.0.0.0 --port 7770 --no-open",
		"storybook": "storybook dev -p 6006 --no-open",
		"swizzle": "docusaurus swizzle",
		"test:e2e": "playwright test",
		"test:search": "playwright test --project search",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:ui": "playwright test --ui",
		"typecheck": "tsc",
		"write-heading-ids": "docusaurus write-heading-ids",
		"write-translations": "docusaurus write-translations"
	},
	"dependencies": {
		"@docusaurus/core": "^3.10.2",
		"@docusaurus/faster": "^3.10.2",
		"@docusaurus/plugin-client-redirects": "^3.10.2",
		"@docusaurus/plugin-content-docs": "^3.10.2",
		"@docusaurus/preset-classic": "^3.10.2",
		"@docusaurus/theme-classic": "^3.10.2",
		"@docusaurus/theme-common": "^3.10.2",
		"@docusaurus/theme-mermaid": "^3.10.2",
		"@mailwoman/cartographer": "workspace:*",
		"@mailwoman/core": "workspace:*",
		"@mailwoman/license-worker": "workspace:*",
		"@mailwoman/neural": "workspace:*",
		"@mailwoman/react": "workspace:^",
		"@mailwoman/resolver": "workspace:*",
		"@mailwoman/resolver-wof-sqlite": "workspace:*",
		"@mailwoman/resolver-wof-wasm": "workspace:*",
		"@mailwoman/spatial": "workspace:*",
		"@mailwoman/sqlite": "workspace:*",
		"@mdx-js/react": "^3.1.1",
		"@protomaps/basemaps": "^5.7.2",
		"@sister.software/docusaurus-theme": "^14.7.0",
		"@sister.software/fonts": "^14.7.0",
		"@sister.software/theme": "^14.7.0",
		"clsx": "^2.1.1",
		"docusaurus-plugin-glossary": "^3.4.0",
		"domhandler": "^6.0.1",
		"domutils": "^4.0.2",
		"htmlparser2": "^12.0.0",
		"js-yaml": "^5.5.0",
		"mailwoman": "workspace:*",
		"maplibre-gl": "^6.16.0",
		"onnxruntime-web": "1.31.1",
		"path-ts": "^2.5.0",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-map-gl": "^8.1.3"
	},
	"devDependencies": {
		"@docusaurus/module-type-aliases": "^3.10.2",
		"@docusaurus/types": "^3.10.2",
		"@mailwoman/browser": "workspace:*",
		"@playwright/test": "^1.64.1",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-map-gl": "^6.1.10",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.1.2",
		"find-free-ports": "^3.1.1",
		"playwright": "^1.64.1",
		"spliterator": "^10.1.1",
		"storybook": "^10.6.5",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"unist": "^0.0.1",
		"unist-util-visit": "^5.2.0",
		"vite": "^8.3.5"
	},
	"browserslist": {
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	},
	"engines": {
		"node": ">=24.0"
	}
}
